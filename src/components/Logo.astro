---
interface Props {
	href?: string;
	footer?: boolean;
}

const { href = '/', footer = false } = Astro.props;
const idPrefix = footer ? 'teejays-footer' : 'teejays-header';
---

<a class:list={['logo', footer && 'footer-logo']} href={href} aria-label="TeeJays Disco home">
	<svg class="teejays-logo" viewBox="0 0 380 100" role="img" aria-labelledby={`${idPrefix}-title`}>
		<title id={`${idPrefix}-title`}>TeeJays Disco</title>

		<!-- Vinyl disc mark -->
		<g transform="translate(50, 50)">
			<circle r="44" fill="#0E0C13" stroke="#F4EFE3" stroke-width="2" />
			<circle r="38" fill="none" stroke="#DCFF3F" stroke-width="1" opacity="0.45" stroke-dasharray="2 3" />
			<circle r="30" fill="none" stroke="#F4EFE3" stroke-width="0.8" opacity="0.28" />
			<circle r="22" fill="none" stroke="#F4EFE3" stroke-width="0.8" opacity="0.28" />
			<circle r="15" fill="#FF2D7E" />
			<text x="0" y="2" text-anchor="middle" font-family="Anton, Impact, sans-serif" font-size="11" fill="#F4EFE3" letter-spacing="0.4">TJ</text>
			<circle r="2.5" fill="#0E0C13" />
		</g>

		<!-- Wordmark -->
		<g class="logo-wordmark">
			<text x="108" y="55" font-family="Anton, Impact, sans-serif" font-size="54" fill="#F4EFE3" letter-spacing="-1">TEEJAYS</text>
		</g>

		<!-- Sticker DISCO badge -->
		<g transform="translate(108, 65) rotate(-3 60 14)">
			<rect x="0" y="0" width="142" height="26" rx="13" fill="#FF2D7E" />
			<text x="71" y="19" text-anchor="middle" font-family="Anton, Impact, sans-serif" font-size="20" fill="#0E0C13" letter-spacing="6">DISCO</text>
		</g>

		<!-- Beat indicator -->
		<g class="logo-beats" transform="translate(264, 38)">
			<rect x="0" y="6" width="4" height="14" rx="1.5" fill="#DCFF3F">
				<animate attributeName="height" values="14;6;14" dur="0.9s" repeatCount="indefinite" />
				<animate attributeName="y" values="6;10;6" dur="0.9s" repeatCount="indefinite" />
			</rect>
			<rect x="8" y="2" width="4" height="22" rx="1.5" fill="#DCFF3F">
				<animate attributeName="height" values="22;10;22" dur="1.1s" repeatCount="indefinite" />
				<animate attributeName="y" values="2;8;2" dur="1.1s" repeatCount="indefinite" />
			</rect>
			<rect x="16" y="0" width="4" height="26" rx="1.5" fill="#DCFF3F">
				<animate attributeName="height" values="26;12;26" dur="0.75s" repeatCount="indefinite" />
				<animate attributeName="y" values="0;7;0" dur="0.75s" repeatCount="indefinite" />
			</rect>
			<rect x="24" y="4" width="4" height="18" rx="1.5" fill="#DCFF3F">
				<animate attributeName="height" values="18;6;18" dur="1s" repeatCount="indefinite" />
				<animate attributeName="y" values="4;10;4" dur="1s" repeatCount="indefinite" />
			</rect>
		</g>
	</svg>
</a>
