---
import { areas, business, contact, services } from '../data/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="footer" itemscope itemtype="https://schema.org/LocalBusiness">
	<div class="footer-col footer-brand">
		<Logo footer />
		<p>Tony &amp; John, 35+ years each of music, memories and dancefloors across Tameside, Manchester and the North West.</p>
		<meta itemprop="name" content={business.name} />
		<meta itemprop="priceRange" content={business.priceRange} />
	</div>

	<div class="footer-col">
		<h3>Services</h3>
		<a href="/services/">All services</a>
		{services.map((service) => <a href={`/services/${service.slug}/`}>{service.title}</a>)}
	</div>

	<div class="footer-col">
		<h3>Areas Covered</h3>
		<a href="/areas/">All areas</a>
		{areas.filter((area) => area.featured).map((area) => <a href={`/areas/${area.slug}/`}>{area.name}</a>)}
		<a href="/areas/">+ {areas.filter((area) => !area.featured).length} more areas</a>
	</div>

	<div class="footer-col">
		<h3>Company</h3>
		<a href="/about/">About</a>
		<a href="/gallery/">Gallery</a>
		<a href="/reviews/">Reviews</a>
		<a href="/faq/">FAQ</a>
		<a href="/sitemap/">Sitemap</a>
		<a href="/contact/">Contact</a>
	</div>

	<div class="footer-col">
		<h3>Get In Touch</h3>
		<a href={contact.phoneHref} itemprop="telephone">{contact.phone}</a>
		<a href={contact.emailHref} itemprop="email">{contact.email}</a>
		<span itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
			<span itemprop="addressLocality">{business.addressLocality}</span>,
			<span itemprop="addressRegion">{business.addressRegion}</span>
		</span>
	</div>
</footer>

<div class="legal">
	<span>© {year} {business.name}. All rights reserved.</span>
	<span>
		<a href="/privacy/">Privacy Policy</a> | <a href="/terms/">Terms &amp; Conditions</a> | <a href="/sitemap/">Sitemap</a>
	</span>
	<a class="site-credit" href="https://happywebs.co.uk/" target="_blank" rel="noopener noreferrer" aria-label="Website by Happy Webs">
		<span>Website by</span>
		<img src="/images/happy-webs-logo.svg" alt="Happy Webs" width="86" height="16" loading="lazy" decoding="async" />
	</a>
</div>
