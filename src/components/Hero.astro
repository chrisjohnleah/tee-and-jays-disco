---
import { contact } from '../data/site';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import djPortrait from '../assets/images/john-tony-djs-portrait.png';
---

<section class="hero">
	<div class="hero-grid">
		<div class="hero-copy">
			<span class="hero-eyebrow">Live · Available 2026</span>

			<h1>
				Mobile DJs for
				<span class="lime">Tameside</span>
				<span class="amp">&amp;</span>
				<span class="pink">Manchester</span>
			</h1>

			<p class="hero-lede">
				Tony &amp; John — <strong>35+ years each</strong> of weddings, parties and packed-out pubs across Greater Manchester. Real DJs, not a playlist. We read the room. We keep it moving.
			</p>

			<p class="hero-script" aria-hidden="true">— booked. set up. <em>sorted.</em></p>

			<div class="hero-actions">
				<a class="button primary" href="/contact/">
					<Icon name="calendar" />
					Get a Free Quote
				</a>
				<a class="button ghost" href={contact.phoneHref}>
					<Icon name="phone" />
					{contact.phone}
				</a>
			</div>

			<div class="hero-meta">
				<span class="hero-meta-item">
					<span class="hero-stars" aria-label="5 star rating">
						<Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
					</span>
					<strong>5.0</strong>
				</span>
				<span class="hero-meta-item"><Icon name="shield" /> Fully insured</span>
				<span class="hero-meta-item"><Icon name="pin" /> Greater Manchester</span>
			</div>
		</div>

		<figure class="hero-photo portrait">
			<Image
				src={djPortrait}
				alt="Tony and John of TeeJays Disco at the decks under stage lights, headphones around their necks, mixing for a live crowd."
				fetchpriority="high"
				decoding="async"
				loading="eager"
			/>
			<figcaption>Tony &amp; John — your DJs.</figcaption>
			<div class="hero-sticker" aria-hidden="true">
				<span>35+</span>
				Years<br />on the<br />decks
			</div>
		</figure>
	</div>
</section>
