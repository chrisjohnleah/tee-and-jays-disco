---
import type { Service } from '../data/site';
import Icon from './Icon.astro';

interface Props {
	service: Service;
}

const { service } = Astro.props;
---

<a class="service-card" href={`/services/${service.slug}/`} style={`--accent:${service.accent}`}>
	<div class="service-image">
		<img src={service.image} alt={`${service.title} DJ at a TeeJays Disco event`} width="1200" height="800" loading="lazy" decoding="async" />
	</div>
	<div class="service-icon">
		<Icon name={service.icon} />
	</div>
	<h3>{service.title}</h3>
	<p>{service.copy}</p>
</a>
