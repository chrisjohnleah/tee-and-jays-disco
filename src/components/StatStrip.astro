---
import Icon from './Icon.astro';

const facts = [
	{ icon: 'star', big: '35+', small: 'years each, two DJs' },
	{ icon: 'users', big: '1000s', small: 'of dancefloors filled' },
	{ icon: 'shield', big: 'Insured', small: 'PAT-tested gear' },
	{ icon: 'speaker', big: 'Pro Sound', small: 'and lighting included' },
	{ icon: 'pin', big: 'GM-wide', small: 'Tameside · Manchester · North West' },
] as const;
---

<section class="stat-strip" aria-label="TeeJays highlights">
	<div class="stat-wrap">
		{facts.map((fact) => (
			<div class="stat">
				<Icon name={fact.icon as any} />
				<strong>{fact.big}</strong>
				<span>{fact.small}</span>
			</div>
		))}
	</div>
</section>
