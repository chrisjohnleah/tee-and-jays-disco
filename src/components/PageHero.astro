---
interface Props {
	title: string;
	subtitle: string;
	image?: string;
	imageAlt?: string;
}

const {
	title,
	subtitle,
	image = '/images/services/birthday-parties.jpg',
	imageAlt = '',
} = Astro.props;
---

<section class="page-hero">
	<img src={image} alt={imageAlt} width="1800" height="900" fetchpriority="high" decoding="async" />
	<div class="page-hero-wash" aria-hidden="true"></div>
	<div class="page-hero-inner">
		<h1>{title}</h1>
		<p>{subtitle}</p>
	</div>
</section>
