---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
	title: string;
	subtitle: string;
	/** Can be an imported image (best) or a public path string */
	image?: any;
	imageAlt?: string;
	/** Optional conversion CTAs rendered directly in hero for above-the-fold impact. Benefit-driven, large tap targets. */
	ctas?: Array<{
		label: string;
		href: string;
		icon?: string; // icon name from Icon component
		variant?: 'primary' | 'ghost' | 'whatsapp';
	}>;
}

const {
	title,
	subtitle,
	image = '/images/services/birthday-parties.jpg',
	imageAlt = '',
	ctas = [],
} = Astro.props;
---

<section class="page-hero">
	<Image
		src={image}
		alt={imageAlt || `${title} with TeeJays Disco`}
		width={1800}
		height={900}
		loading="eager"
		fetchpriority="high"
		decoding="async"
		sizes="100vw"
	/>
	<div class="page-hero-wash" aria-hidden="true"></div>
	<div class="page-hero-inner">
		<h1>{title}</h1>
		<p>{subtitle}</p>
		{ctas.length > 0 && (
			<div class="hero-ctas">
				{ctas.map((cta) => (
					<a 
						class:list={['button', cta.variant === 'primary' && 'primary', cta.variant === 'whatsapp' && 'whatsapp', cta.variant === 'ghost' && 'ghost', 'button-lg']}
						href={cta.href}
						{...(cta.variant === 'whatsapp' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					>
						{cta.icon && <Icon name={cta.icon as any} />}
						{cta.label}
					</a>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-5);
		justify-content: center;
	}
	/* Ensure hero CTAs stand out on the dark wash overlay */
	.hero-ctas .button {
		box-shadow: 4px 4px 0 var(--ink), 0 8px 20px rgba(0,0,0,0.3);
	}
	@media (max-width: 480px) {
		.hero-ctas {
			flex-direction: column;
			align-items: stretch;
		}
		.hero-ctas .button {
			width: 100%;
			justify-content: center;
		}
	}
</style>
