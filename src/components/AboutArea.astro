---
import { areas, bullets } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section about-area" id="about">
	<div class="why-panel">
		<div class="why-copy">
			<h2>Why choose TeeJays Disco?</h2>
			<p>We're Tony &amp; John, two lifelong music lovers and professional DJs with over 35 years of experience each, entertaining across Tameside, Manchester and the North West.</p>
			<ul>
				{bullets.map(([title, copy]) => (
					<li>
						<span><Icon name="check" /></span>
						<strong>{title}</strong> {copy}
					</li>
				))}
			</ul>
		</div>
		<img src="https://images.pexels.com/photos/14925309/pexels-photo-14925309.jpeg?auto=compress&cs=tinysrgb&w=900" alt="" loading="lazy" />
		<div class="mini-signature">
			<Icon name="star" />
			<strong>35+ Years Each</strong>
			<span>Tony &amp; John</span>
		</div>
	</div>

	<div class="area-panel">
		<h2>Proudly serving Tameside, Manchester &amp; the North West</h2>
		<div class="area-content">
			<div class="map-card">
				<span class="map-pin manchester">Manchester</span>
				<span class="map-pin ashton">Ashton-under-Lyne</span>
				<span class="map-pin oldham">Oldham</span>
				<span class="map-pin stalybridge">Stalybridge</span>
				<span class="map-pin hyde">Hyde</span>
				<span class="map-pin stockport">Stockport</span>
			</div>
			<div class="area-list">
				<p>We regularly provide DJ services in:</p>
				{areas.map((area) => <span>{area}</span>)}
				<small>and surrounding areas</small>
				<p>Travel further afield? Just ask!</p>
			</div>
		</div>
	</div>
</section>
