---
import { areas, bullets } from '../data/site';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
---

<section class="section about-area" id="about">
	<div class="why-panel">
		<div class="why-copy">
			<h2>Why choose TeeJays Disco?</h2>
			<p>We're Tony &amp; John — two lifelong music lovers and professional DJs with 35+ years each, reading rooms across Tameside, Manchester and the North West.</p>
			<ul>
				{bullets.map(([title, copy]) => (
					<li>
						<span><Icon name="check" /></span>
						<div><strong>{title}</strong> &mdash; {copy}</div>
					</li>
				))}
			</ul>
		</div>
		<Image
			src="/images/gallery/dj-setup.jpg"
			alt="TeeJays Disco professional sound and lighting setup at a venue"
			width={1200}
			height={800}
			loading="lazy"
			decoding="async"
		/>
		<div class="mini-signature">
			<Icon name="star" />
			<strong>35+ Years Each</strong>
			<span>Tony &amp; John</span>
		</div>
	</div>

	<div class="area-panel">
		<h2>We're a Tameside &amp; Greater Manchester act</h2>
		<p class="area-lede">From Ashton to Altrincham, Bury to Bramhall — we set up across the whole of Greater Manchester and the North West.</p>
		<ul class="featured-areas">
			{areas.filter((area) => area.featured).map((area) => (
				<li><a href={`/areas/${area.slug}/`}>{area.name}</a></li>
			))}
		</ul>
		<p class="area-footnote">+ surrounding villages, country venues and travel further afield on request. <a href="/contact/" class="area-cta">Venue not listed? Drop us a line →</a></p>
	</div>
</section>
