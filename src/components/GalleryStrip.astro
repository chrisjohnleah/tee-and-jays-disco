---
import { gallery } from '../data/site';
import { Image } from 'astro:assets';
import SectionTitle from './SectionTitle.astro';

interface Props {
	limit?: number;
}

const { limit = 6 } = Astro.props;

// Diverse sample: one from each category in turn until we hit the limit
const seenCategories = new Set<string>();
const diversePicks = [] as typeof gallery;

for (const item of gallery) {
	if (!seenCategories.has(item.category)) {
		diversePicks.push(item);
		seenCategories.add(item.category);
	}
	if (diversePicks.length >= limit) break;
}

// If we still have room (fewer categories than limit), top up from remaining
if (diversePicks.length < limit) {
	for (const item of gallery) {
		if (!diversePicks.includes(item)) {
			diversePicks.push(item);
			if (diversePicks.length >= limit) break;
		}
	}
}

const images = diversePicks;
---

<section class="gallery" id="gallery">
	<SectionTitle title="Gallery" subtitle="A glimpse from weddings, parties and events across Greater Manchester." compact />
	<div class="gallery-row">
		{images.map((image) => (
		<Image
			src={image.src}
			alt={image.alt}
			width={900}
			height={600}
			loading="lazy"
			decoding="async"
			sizes="(min-width: 1024px) 16vw, (min-width: 768px) 25vw, 50vw"
		/>
	))}
	</div>
	<p>See the full gallery — <a href="/gallery/">filter by event type</a>.</p>
</section>
