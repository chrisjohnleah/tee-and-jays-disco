---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Layout from '../../layouts/Layout.astro';
import { areas, business, contact, localIntelligence } from '../../data/site';
import ReviewsGrid from '../../components/ReviewsGrid.astro';
import StatStrip from '../../components/StatStrip.astro';

export const prerender = true;

export function getStaticPaths() {
  const supportedAreas = Object.keys(localIntelligence);
  return areas
    .filter((a) => supportedAreas.includes(a.slug))
    .map((area) => ({ params: { slug: area.slug } }));
}

const { slug } = Astro.params;
const area = areas.find((a) => a.slug === slug)!;
const intel = localIntelligence[slug];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? business.url;

// === NEW: Area-specific hero images using the new Pexels community events photography collection ===
// Each of the 8 pages gets a distinct, high-quality visual to boost engagement & uniqueness
const communityHeroImages: Record<string, { src: string; alt: string }> = {
  'tameside': {
    src: '/images/services/community/community-outdoor-dj-festival-crowd-33014611.jpg',
    alt: `Large crowd enjoying an outdoor community festival with DJ and dancing in Tameside`
  },
  'ashton-under-lyne': {
    src: '/images/services/community/community-street-festival-dancing-crowd-34690258.jpg',
    alt: `Street festival dancing crowd at a vibrant community event in Ashton-under-Lyne`
  },
  'hyde': {
    src: '/images/services/community/community-outdoor-dj-festival-crowd-33014611.jpg',
    alt: `Outdoor festival crowd with DJ at a community gathering in Hyde`
  },
  'stalybridge': {
    src: '/images/services/community/community-street-festival-dancing-crowd-34690258.jpg',
    alt: `Local community street festival with people dancing in Stalybridge`
  },
  'stockport': {
    src: '/images/services/community/community-outdoor-dj-festival-crowd-33014611.jpg',
    alt: `Big outdoor crowd at a Stockport community festival or fundraiser with TeeJays`
  },
  'oldham': {
    src: '/images/services/community/community-street-festival-dancing-crowd-34690258.jpg',
    alt: `Dancing at a lively street festival community event in Oldham`
  },
  'manchester': {
    src: '/images/services/community/community-outdoor-dj-festival-crowd-33014611.jpg',
    alt: `Diverse crowd at a Manchester community festival or outdoor celebration`
  },
  'altrincham': {
    src: '/images/services/community/community-street-festival-dancing-crowd-34690258.jpg',
    alt: `Family-friendly street festival dancing in Altrincham community event`
  },
};
const heroImage = communityHeroImages[slug] || { 
  src: '/images/services/community/community-outdoor-dj-festival-crowd-33014611.jpg', 
  alt: `Community crowd enjoying a festival or local event with dancing in ${area.name}` 
};

const nearbyList = (intel.nearbyAreas || [])
  .map((ns) => areas.find((a) => a.slug === ns))
  .filter((a): a is NonNullable<typeof areas[number]> => Boolean(a));

// Derived unique content — powers strong, area-specific meta titles & descriptions (and will power more content later)
const venueList = intel.venues.map((v) => v.name).join(' and ');
const topRequests = intel.crowdProfile.requests.slice(0, 3).join(', ');
const crowdVibe = intel.crowdProfile.vibe;
const typicalCrowd = intel.crowdProfile.typicalAges;
const primaryVenue = intel.venues[0];
const milestoneInsight = `Community events in ${area.name} need music that works for mixed ages and families — fundraisers, festivals and local gatherings where everyone from kids to grandparents can enjoy the night.`;
const hasStories = intel.stories.length > 0;
const logisticsSummary = intel.logistics.map((l) => l.detail).join(' ');

// === NEW: Area-tailored FAQ for SEO ===
const areaFAQs = [
  {
    q: `What kind of music works for community events and fundraisers in ${area.name}?`,
    a: `${milestoneInsight} We know the venues like ${venueList} and keep the energy right for the whole community.`
  },
  {
    q: `How do you handle logistics and timing for ${area.name} community events?`,
    a: `${logisticsSummary} We’re flexible and reliable — perfect for local organisers.`
  },
  {
    q: `Can you keep community events in ${area.name} family-friendly while still fun?`,
    a: `Absolutely — ${area.name} crowds love ${topRequests}. We read the room and keep it inclusive for all ages.`
  },
];
if (intel.logistics.length > 0) {
  areaFAQs.push({ q: `What should we know about booking community DJs in ${area.name}?`, a: `${intel.logistics[0].detail} We deliver every time.` });
}

// Enhanced Schema for SEO
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Community Event DJ Hire',
  provider: {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}/#business`,
    name: business.name,
  },
  areaServed: {
    '@type': 'Place',
    name: area.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: area.name,
      addressRegion: business.addressRegion,
      addressCountry: business.addressCountry,
    },
  },
  name: `Community Event DJs in ${area.name}`,
  description: `Professional community event DJs in ${area.name}. ${intel.localPride} 35+ years experience. Festivals, fundraisers and local gatherings with deep knowledge of ${venueList}.`,
  url: `${siteUrl}/community-djs/${area.slug}/`,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: areaFAQs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<Layout
  title={`Community Event DJs in ${area.name} | TeeJays Disco`}
  description={`${intel.localPride} Professional community event DJs in ${area.name} with 35+ years experience. Festivals, fundraisers and local gatherings for ${typicalCrowd} who enjoy ${topRequests} at venues like ${venueList}. Family-friendly, flexible hosting. Full sound, lighting & MC. Serving ${area.name} and Greater Manchester.`}
>
  <!-- Preload the LCP hero image for this specific area+service page to improve mobile Core Web Vitals (LCP) -->
  <link slot="head" rel="preload" as="image" href={heroImage.src} fetchpriority="high" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <main class="page">
    <Header />

    <!-- Prominent phone-first conversion bar — visible immediately for highest mobile conversion on community event location pages -->
    <div class="top-phone-cta">
      <div class="top-phone-inner">
        <span class="top-phone-label">Your local {area.name} community event DJs — call now</span>
        <a class="top-phone-link" href={contact.phoneHref}>
          <Icon name="phone" /> <strong>{contact.phone}</strong>
        </a>
        <a class="top-phone-link whatsapp" href={contact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> WhatsApp Tony &amp; John
        </a>
        <span class="top-phone-urgency">Most popular {area.name} community dates book 2–3 months ahead — secure yours</span>
      </div>
    </div>

    <PageHero
      title={`Community DJs in ${area.name}`}
      subtitle={`Family-friendly, flexible, and proper local.`}
      image={heroImage.src}
      imageAlt={heroImage.alt}
      ctas={[
        { label: `Check ${area.name} community event availability`, href: '/contact/', icon: 'calendar', variant: 'primary' },
        { label: `Call Tony & John: ${contact.phone}`, href: contact.phoneHref, icon: 'phone', variant: 'ghost' },
        { label: 'WhatsApp us now', href: contact.whatsappHref, icon: 'whatsapp', variant: 'whatsapp' },
      ]}
    />

    <section class="section">
      <Breadcrumbs items={[{ label: 'Community DJs', href: '/community-djs/' }, { label: area.name }]} />

      <div class="content-panel">
        <div class="content-card">
          <h2>Community DJs in {area.name} who get the vibe</h2>
          <p class="lede">{intel.localPride}</p>
          <p>
            Community events in {area.name} bring together families, all ages, and local pride. We know how to keep it suitable for everyone while still creating moments that the adults remember too.
          </p>
          <ul class="check-list">
            <li><span><Icon name="check" /></span>35+ years with real community and family crowds</li>
            <li><span><Icon name="check" /></span>Flexible sets from afternoon into the evening</li>
            <li><span><Icon name="check" /></span>Experience at outdoor venues, village halls and sports clubs</li>
            <li><span><Icon name="check" /></span>Professional yet approachable with organisers and volunteers</li>
          </ul>

          <!-- Primary phone + form CTA right after value props for immediate conversion on mobile -->
          <div class="cta-group primary-conversion">
            <a class="button primary button-lg" href="/contact/">
              <Icon name="calendar" />
              Check Availability in {area.name}
            </a>
            <a class="button ghost button-lg" href={contact.phoneHref}>
              <Icon name="phone" />
              Call Tony &amp; John now: {contact.phone}
            </a>
          </div>
          <p class="cta-note"><strong>Most popular {area.name} community &amp; fundraiser dates book 3–6 months ahead.</strong> Secure local DJs who understand the crowd and venue quirks — enquire today.</p>
        </div>

        <div class="content-card">
          <h2>Venues we know for community events in {area.name}</h2>
          {intel.venues.length > 0 ? (
            <div class="venue-intel-grid">
              {intel.venues.map((venue) => (
                <div class="venue-intel-card">
                  <div class="venue-header">
                    <strong>{venue.name}</strong>
                    <span class="venue-type">{venue.type.replace('-', ' ')}</span>
                  </div>
                  <p class="venue-notes">{venue.notes}</p>

                  <div class="venue-specs">
                    {venue.capacity && <div><span>Capacity</span> {venue.capacity}</div>}
                    <div><span>Parking</span> {venue.parking}</div>
                    <div><span>Power</span> {venue.power}</div>
                    <div><span>Loading</span> {venue.loading}</div>
                  </div>

                  {venue.musicFit && <p class="venue-music"><strong>Music fit:</strong> {venue.musicFit}</p>}
                  {venue.lastPlayed && <p class="venue-story"><em>{venue.lastPlayed}</em></p>}
                </div>
              ))}
            </div>
          ) : (
            <p>We regularly play community events, fundraisers and festivals across {area.name}. Ask us about your venue.</p>
          )}

          <!-- Stronger post-venues conversion CTA with phone for organisers -->
          <div class="venue-cta">
            <p><strong>Know the venue but want DJs who actually know {area.name} community crowds?</strong> We’ve powered up the dancefloor at these exact rooms and know how to keep families, volunteers and all ages happy with the right mix of music and energy.</p>
            <div class="cta-group">
              <a class="button primary" href="/contact/">
                <Icon name="calendar" /> Check {area.name} community availability
              </a>
              <a class="button ghost" href={contact.phoneHref}>
                <Icon name="phone" /> Call us: {contact.phone}
              </a>
            </div>
            <p class="cta-note" style="margin-top: var(--space-3);"><strong>3–6 months is typical</strong> for the best {area.name} community event slots. Your date is filling up — reach us today.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <SectionTitle title={`Other events in ${area.name}`} subtitle="Friendly, flexible DJs for every community gathering and celebration." />
      <div class="area-link-grid">
        <a class="area-link-card" href={`/wedding-djs/${slug}/`}>
          <Icon name="rings" />
          <span>Wedding DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/birthday-party-djs/${slug}/`}>
          <Icon name="cake" />
          <span>Birthday DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/anniversary-djs/${slug}/`}>
          <Icon name="heart" />
          <span>Anniversary DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/corporate-djs/${slug}/`}>
          <Icon name="briefcase" />
          <span>Corporate DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href="/community-djs/">
          <Icon name="group" />
          <span>See all Community areas</span>
        </a>
      </div>
    </section>

    {nearbyList.length > 0 && (
      <section class="section">
        <SectionTitle title={`Community Event DJs in nearby towns`} subtitle="The same approachable, local approach for fundraisers, festivals and gatherings just down the road." />
        <div class="area-link-grid">
          {nearbyList.map((nearArea) => (
            <a class="area-link-card" href={`/community-djs/${nearArea.slug}/`}>
              <Icon name="group" />
              <span>Community Events in {nearArea.name}</span>
            </a>
          ))}
          <a class="area-link-card" href="/community-djs/">
            <Icon name="group" />
            <span>All Community areas</span>
          </a>
        </div>
      </section>
    )}

    <!-- Final high-visibility phone CTA + urgency for conversion -->
    <section class="section trust-final">
      <div class="final-cta">
        <h3>Ready to book community DJs who bring the right energy to {area.name}?</h3>
        <p>Call Tony &amp; John or send a quick enquiry. We’ll talk through your venue, timings, crowd mix, and the music that will make your community event or fundraiser in {area.name} a real success.</p>
        <div class="cta-group">
          <a class="button primary button-lg" href={contact.phoneHref}>
            <Icon name="phone" /> Call {contact.phone}
          </a>
          <a class="button ghost button-lg" href="/contact/">Send enquiry for {area.name} community event</a>
        </div>
        <p class="small-note">Based in Tameside. Covering {area.name} and Greater Manchester. 35+ years experience. Local DJs who know how to read every generation in the room.</p>
      </div>
    </section>

    <!-- Pre-selected community event + context for community location pages -->
    <ContactBlock 
      faq={false} 
      defaultEventType="Community Event"
      headline={`Ready to book ${area.name} community event DJs?`}
      subtitle={`Tell us your date, venue and crowd details. Local ${area.name} DJs will confirm availability and quote quickly for your fundraiser or festival.`}
      contextNote={`Friendly ${area.name} community DJs — experienced with mixed-age crowds at local events, fetes and fundraisers.`}
      source={`community-djs-${slug}`}
    />
    <Footer />
  </main>
</Layout>

<style>
  .lede { font-size: 1.1rem; font-weight: 600; color: var(--ink); }
  .venue-intel-grid { display: grid; gap: var(--space-5); margin-top: var(--space-4); }
  @media (min-width: 720px) { .venue-intel-grid { grid-template-columns: repeat(2, 1fr); } }
  .venue-intel-card { background: var(--paper-2); border: 2px solid var(--ink); border-radius: var(--radius-md); padding: var(--space-5); box-shadow: var(--shadow-soft); }
  .venue-header { display: flex; justify-content: space-between; margin-bottom: var(--space-3); }
  .venue-header strong { font-size: 1.1rem; }
  .venue-notes { font-size: 0.95rem; line-height: 1.5; margin-bottom: var(--space-4); }
  .venue-specs { display: grid; grid-template-columns: 1fr; gap: var(--space-2); font-size: 0.85rem; margin-bottom: var(--space-3); }
  .venue-specs div { display: flex; gap: var(--space-2); }
  .venue-specs span { font-weight: 600; min-width: 70px; color: var(--pink); }
  .venue-music { font-size: 0.9rem; margin: 0; }
  .venue-type {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--ink);
    color: var(--paper);
    padding: 2px 8px;
    border-radius: 9999px;
  }
  .venue-story {
    font-size: 0.9rem;
    margin: 0;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Phone CTA & Urgency styles — consistent prominent tap-friendly CTAs + real booking pressure on every community page */
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .cta-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
    font-style: italic;
  }
  .venue-cta {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: linear-gradient(145deg, var(--paper), var(--paper-2));
    border: 2px solid var(--pink);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .venue-cta p {
    margin-bottom: var(--space-3);
    font-size: 0.95rem;
  }
  .trust-final {
    text-align: center;
  }
  .final-cta {
    max-width: 720px;
    margin: var(--space-6) auto 0;
    padding: var(--space-6);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-lg);
  }
  .final-cta h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-bottom: var(--space-3);
    color: var(--paper);
  }
  .final-cta p {
    opacity: 0.95;
    margin-bottom: var(--space-4);
  }
  .final-cta .small-note {
    font-size: 0.8rem;
    opacity: 0.8;
    margin-top: var(--space-4);
  }
  .content-panel .venue-intel-grid {
    margin-top: var(--space-3);
  }
</style>
