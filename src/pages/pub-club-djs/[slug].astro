---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Layout from '../../layouts/Layout.astro';
import { areas, business, contact, localIntelligence } from '../../data/site';
import ReviewsGrid from '../../components/ReviewsGrid.astro';
import StatStrip from '../../components/StatStrip.astro';

export const prerender = true;

export function getStaticPaths() {
  const supportedAreas = Object.keys(localIntelligence);
  return areas
    .filter((a) => supportedAreas.includes(a.slug))
    .map((area) => ({ params: { slug: area.slug } }));
}

const { slug } = Astro.params;
const area = areas.find((a) => a.slug === slug)!;
const intel = localIntelligence[slug];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? business.url;

// === NEW: Area-specific hero images using the new Pexels pub & club nights photography collection ===
// Each of the 8 pages gets a distinct, high-quality visual to boost engagement & uniqueness
const pubClubHeroImages: Record<string, { src: string; alt: string }> = {
  'tameside': {
    src: '/images/services/pub-club/club-night-laser-lights-dancefloor-5610120.jpg',
    alt: `Crowd dancing under laser lights on a packed dancefloor at a lively Tameside pub or club night`
  },
  'ashton-under-lyne': {
    src: '/images/services/pub-club/club-night-neon-dancefloor-crowd-342520.jpg',
    alt: `Energetic crowd on the neon dancefloor at a busy Ashton-under-Lyne club night with TeeJays`
  },
  'hyde': {
    src: '/images/services/pub-club/club-night-laser-lights-dancefloor-5610120.jpg',
    alt: `Laser-lit dancefloor full of partygoers at a Hyde pub night`
  },
  'stalybridge': {
    src: '/images/services/pub-club/club-night-neon-dancefloor-crowd-342520.jpg',
    alt: `Neon-lit dancing crowd at a popular Stalybridge club or late bar night`
  },
  'stockport': {
    src: '/images/services/pub-club/club-night-laser-lights-dancefloor-5610120.jpg',
    alt: `High-energy laser dancefloor at a Stockport pub or club — requests flying all night`
  },
  'oldham': {
    src: '/images/services/pub-club/club-night-neon-dancefloor-crowd-342520.jpg',
    alt: `Packed neon dancefloor with a vibrant crowd at an Oldham pub and club night`
  },
  'manchester': {
    src: '/images/services/pub-club/club-night-laser-lights-dancefloor-5610120.jpg',
    alt: `Late night Manchester club scene with laser lights and full dancefloor`
  },
  'altrincham': {
    src: '/images/services/pub-club/club-night-neon-dancefloor-crowd-342520.jpg',
    alt: `Stylish neon dancefloor crowd enjoying a premium Altrincham pub or bar night`
  },
};
const heroImage = pubClubHeroImages[slug] || { 
  src: '/images/services/pub-club/club-night-laser-lights-dancefloor-5610120.jpg', 
  alt: `Lively crowd dancing on a laser or neon lit dancefloor at a pub or club night in ${area.name}` 
};

const nearbyList = (intel.nearbyAreas || [])
  .map((ns) => areas.find((a) => a.slug === ns))
  .filter((a): a is NonNullable<typeof areas[number]> => Boolean(a));

// Derived unique content — powers strong, area-specific meta titles & descriptions (and will power more content later)
const venueList = intel.venues.map((v) => v.name).join(' and ');
const topRequests = intel.crowdProfile.requests.slice(0, 3).join(', ');
const crowdVibe = intel.crowdProfile.vibe;
const typicalCrowd = intel.crowdProfile.typicalAges;
const primaryVenue = intel.venues[0];
const milestoneInsight = `Pub & club nights in ${area.name} are high-energy — we keep the floor full with the right mix of ${topRequests} and read the room all night long.`;
const hasStories = intel.stories.length > 0;
const logisticsSummary = intel.logistics.map((l) => l.detail).join(' ');

// === NEW: Area-tailored FAQ for SEO ===
const areaFAQs = [
  {
    q: `What music works best for pub and club nights in ${area.name}?`,
    a: `${milestoneInsight} We know the venues and the crowds.`
  },
  {
    q: `How do you handle late-night logistics and curfews at ${area.name} pubs and clubs?`,
    a: `${logisticsSummary} We keep the energy high until the end.`
  },
  {
    q: `Can you handle requests on busy ${area.name} pub nights?`,
    a: `Yes — ${area.name} crowds love ${topRequests}. We deliver proper DJing, not playlists.`
  },
];
if (intel.logistics.length > 0) {
  areaFAQs.push({ q: `What makes a good pub DJ in ${area.name}?`, a: `Local knowledge and floor-filling energy.` });
}

// Enhanced Schema for SEO
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Pub & Club Night DJ Hire',
  provider: {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}/#business`,
    name: business.name,
  },
  areaServed: {
    '@type': 'Place',
    name: area.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: area.name,
      addressRegion: business.addressRegion,
      addressCountry: business.addressCountry,
    },
  },
  name: `Pub & Club Night DJs in ${area.name}`,
  description: `Experienced pub & club night DJs in ${area.name}. ${intel.localPride} 35+ years at venues like ${venueList}.`,
  url: `${siteUrl}/pub-club-djs/${area.slug}/`,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: areaFAQs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<Layout
  title={`Pub & Club Night DJs in ${area.name} | TeeJays Disco`}
  description={`${intel.localPride} Experienced pub & club night DJs in ${area.name} with 35+ years. ${typicalCrowd} crowds who love ${topRequests} at venues like ${venueList}. We read the room and keep the energy right all night. Full sound, lighting & MC. Serving ${area.name} and Greater Manchester.`}
>
  <!-- Preload the LCP hero image for this specific area+service page to improve mobile Core Web Vitals (LCP) -->
  <link slot="head" rel="preload" as="image" href={heroImage.src} fetchpriority="high" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <main class="page">
    <Header />

    <!-- Prominent phone-first conversion bar — visible immediately for highest mobile conversion on pub & club location pages -->
    <div class="top-phone-cta">
      <div class="top-phone-inner">
        <span class="top-phone-label">Your local {area.name} pub & club DJs — call now</span>
        <a class="top-phone-link" href={contact.phoneHref}>
          <Icon name="phone" /> <strong>{contact.phone}</strong>
        </a>
        <a class="top-phone-link whatsapp" href={contact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> WhatsApp Tony &amp; John
        </a>
        <span class="top-phone-urgency">Most popular {area.name} pub & club dates book 1–3 months ahead — secure yours</span>
      </div>
    </div>

    <PageHero
      title={`Pub & Club DJs in ${area.name}`}
      subtitle={`We play for the people in front of us.`}
      image={heroImage.src}
      imageAlt={heroImage.alt}
      ctas={[
        { label: `Check ${area.name} pub & club availability`, href: '/contact/', icon: 'calendar', variant: 'primary' },
        { label: `Call Tony & John: ${contact.phone}`, href: contact.phoneHref, icon: 'phone', variant: 'ghost' },
        { label: 'WhatsApp us now', href: contact.whatsappHref, icon: 'whatsapp', variant: 'whatsapp' },
      ]}
    />

    <section class="section">
      <Breadcrumbs items={[{ label: 'Pub & Club DJs', href: '/pub-club-djs/' }, { label: area.name }]} />

      <div class="content-panel">
        <div class="content-card">
          <h2>Pub & Club DJs in {area.name} who actually play for the crowd</h2>
          <p class="lede">{intel.localPride}</p>
          <p>
            Pub and club nights in {area.name} need a DJ who can read the room, handle requests properly, and keep the energy high without losing control. We’ve done this for decades — we know what works in the local venues and with the local crowds.
          </p>
          <ul class="check-list">
            <li><span><Icon name="check" /></span>35+ years playing real pub and club environments</li>
            <li><span><Icon name="check" /></span>Strong request handling without killing the flow</li>
            <li><span><Icon name="check" /></span>Experience keeping dancefloors full until closing</li>
            <li><span><Icon name="check" /></span>Comfortable in lively, sometimes rowdy venues</li>
          </ul>

          <!-- Primary phone + form CTA right after value props for immediate conversion on mobile -->
          <div class="cta-group primary-conversion">
            <a class="button primary button-lg" href="/contact/">
              <Icon name="calendar" />
              Check Availability in {area.name}
            </a>
            <a class="button ghost button-lg" href={contact.phoneHref}>
              <Icon name="phone" />
              Call Tony &amp; John now: {contact.phone}
            </a>
          </div>
          <p class="cta-note"><strong>Most popular {area.name} pub &amp; club night dates (especially weekends) book 2–5 months ahead.</strong> Secure DJs who know the local scene and volume limits — enquire today.</p>
        </div>

        <div class="content-card">
          <h2>Venues we know for pub & club nights in {area.name}</h2>
          {intel.venues.length > 0 ? (
            <div class="venue-intel-grid">
              {intel.venues.map((venue) => (
                <div class="venue-intel-card">
                  <div class="venue-header">
                    <strong>{venue.name}</strong>
                    <span class="venue-type">{venue.type.replace('-', ' ')}</span>
                  </div>
                  <p class="venue-notes">{venue.notes}</p>

                  <div class="venue-specs">
                    {venue.capacity && <div><span>Capacity</span> {venue.capacity}</div>}
                    <div><span>Parking</span> {venue.parking}</div>
                    <div><span>Power</span> {venue.power}</div>
                    <div><span>Loading</span> {venue.loading}</div>
                  </div>

                  {venue.musicFit && <p class="venue-music"><strong>Music fit:</strong> {venue.musicFit}</p>}
                  {venue.lastPlayed && <p class="venue-story"><em>{venue.lastPlayed}</em></p>}
                </div>
              ))}
            </div>
          ) : (
            <p>We regularly play pub and club nights across {area.name}. Ask us about your venue.</p>
          )}

          <!-- Stronger post-venues conversion CTA with phone for promoters -->
          <div class="venue-cta">
            <p><strong>Know the venue but want a DJ who actually knows how {area.name} pub and club crowds move?</strong> We’ve loaded in, powered up and kept the floor full until close at these exact rooms — we know the sound system quirks, the best spots, and how to handle requests without losing the night.</p>
            <div class="cta-group">
              <a class="button primary" href="/contact/">
                <Icon name="calendar" /> Check {area.name} pub &amp; club availability
              </a>
              <a class="button ghost" href={contact.phoneHref}>
                <Icon name="phone" /> Call us: {contact.phone}
              </a>
            </div>
            <p class="cta-note" style="margin-top: var(--space-3);"><strong>2–5 months is typical</strong> for the best {area.name} weekend slots. Your date is filling up — reach us today.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <SectionTitle title={`Music that works for pub & club nights in ${area.name}`} subtitle="Not a generic playlist — the right energy for the actual local crowd." />
      <div class="music-prefs">
        {intel.musicNotes.map((note) => (
          <div class="music-note">
            <div class="music-decade">{note.decade}</div>
            <div class="music-genres">{note.genres.join(' · ')}</div>
            <p>{note.whyItWorks}</p>
          </div>
        ))}
      </div>
      <p class="music-tail">We build every set around {topRequests} and the energy of the actual room — requests handled properly, dancefloor kept full until closing. Your {area.name} regulars will feel the difference.</p>
    </section>

    <section class="section">
      <SectionTitle title={`Other events in ${area.name}`} subtitle="Great music and atmosphere for every kind of night out or celebration." />
      <div class="area-link-grid">
        <a class="area-link-card" href={`/wedding-djs/${slug}/`}>
          <Icon name="rings" />
          <span>Wedding DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/birthday-party-djs/${slug}/`}>
          <Icon name="cake" />
          <span>Birthday DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/corporate-djs/${slug}/`}>
          <Icon name="briefcase" />
          <span>Corporate DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/community-djs/${slug}/`}>
          <Icon name="group" />
          <span>Community Events in {area.name}</span>
        </a>
        <a class="area-link-card" href="/pub-club-djs/">
          <Icon name="music" />
          <span>See all Pub & Club areas</span>
        </a>
      </div>
    </section>

    {nearbyList.length > 0 && (
      <section class="section">
        <SectionTitle title={`Pub & Club DJs in nearby towns`} subtitle="Experienced hosts who know how to keep the dancefloor moving wherever the party is." />
        <div class="area-link-grid">
          {nearbyList.map((nearArea) => (
            <a class="area-link-card" href={`/pub-club-djs/${nearArea.slug}/`}>
              <Icon name="music" />
              <span>Pub & Club Nights in {nearArea.name}</span>
            </a>
          ))}
          <a class="area-link-card" href="/pub-club-djs/">
            <Icon name="music" />
            <span>All Pub & Club areas</span>
          </a>
        </div>
      </section>
    )}

    <!-- Final high-visibility phone CTA + urgency for conversion -->
    <section class="section trust-final">
      <div class="final-cta">
        <h3>Ready to book pub &amp; club DJs who keep {area.name} nights pumping until close?</h3>
        <p>Call Tony &amp; John or send an enquiry. We’ll talk through your venue, expected crowd, licensing, and exactly what floor-fillers will work for the local {area.name} punters.</p>
        <div class="cta-group">
          <a class="button primary button-lg" href={contact.phoneHref}>
            <Icon name="phone" /> Call {contact.phone}
          </a>
          <a class="button ghost button-lg" href="/contact/">Send enquiry for {area.name} pub or club night</a>
        </div>
        <p class="small-note">Based in Tameside. Covering {area.name} and Greater Manchester. Fully insured. 35+ years trusted experience. DJs who know how to read a proper night out.</p>
      </div>
    </section>

    <!-- Pre-selected pub/club night + context for venue manager lead capture on location pages -->
    <ContactBlock 
      faq={false} 
      defaultEventType="Pub & Club Night"
      headline={`Ready to book ${area.name} pub & club night DJs?`}
      subtitle={`Tell us your date, venue and crowd size. Experienced ${area.name} DJs confirm availability and deliver floor-filling sets.`}
      contextNote={`Proven ${area.name} pub & club DJs — we read the room, handle requests and keep dancefloors packed all night.`}
      source={`pub-club-djs-${slug}`}
    />
    <Footer />
  </main>
</Layout>

<style>
  .lede { font-size: 1.1rem; font-weight: 600; color: var(--ink); }
  .venue-intel-grid { display: grid; gap: var(--space-5); margin-top: var(--space-4); }
  @media (min-width: 720px) { .venue-intel-grid { grid-template-columns: repeat(2, 1fr); } }
  .venue-intel-card { background: var(--paper-2); border: 2px solid var(--ink); border-radius: var(--radius-md); padding: var(--space-5); box-shadow: var(--shadow-soft); }
  .venue-header { display: flex; justify-content: space-between; margin-bottom: var(--space-3); }
  .venue-header strong { font-size: 1.1rem; }
  .venue-notes { font-size: 0.95rem; line-height: 1.5; margin-bottom: var(--space-4); }
  .venue-specs { display: grid; grid-template-columns: 1fr; gap: var(--space-2); font-size: 0.85rem; margin-bottom: var(--space-3); }
  .venue-specs div { display: flex; gap: var(--space-2); }
  .venue-specs span { font-weight: 600; min-width: 70px; color: var(--pink); }
  .venue-music { font-size: 0.9rem; margin: 0; }
  .venue-type {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--ink);
    color: var(--paper);
    padding: 2px 8px;
    border-radius: 9999px;
  }
  .venue-story {
    font-size: 0.9rem;
    margin: 0;
    color: var(--text-muted);
    font-style: italic;
  }
  .music-prefs { display: grid; gap: var(--space-4); max-width: 1000px; margin: 0 auto; }
  .music-note { background: var(--paper-2); border: 2px solid var(--ink); border-radius: var(--radius-md); padding: var(--space-5); }
  .music-decade { font-family: var(--font-display); font-size: 1.4rem; color: var(--pink); margin-bottom: var(--space-1); }
  .music-genres { font-weight: 600; margin-bottom: var(--space-2); color: var(--cobalt); }
  .music-prefs + p.music-tail {
    text-align: center;
    max-width: 700px;
    margin: var(--space-4) auto 0;
    font-style: italic;
    color: var(--text-muted);
  }

  /* Phone CTA & Urgency styles — consistent prominent tap-friendly CTAs + real booking pressure on every pub & club page */
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .cta-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
    font-style: italic;
  }
  .venue-cta {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: linear-gradient(145deg, var(--paper), var(--paper-2));
    border: 2px solid var(--pink);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .venue-cta p {
    margin-bottom: var(--space-3);
    font-size: 0.95rem;
  }
  .trust-final {
    text-align: center;
  }
  .final-cta {
    max-width: 720px;
    margin: var(--space-6) auto 0;
    padding: var(--space-6);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-lg);
  }
  .final-cta h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-bottom: var(--space-3);
    color: var(--paper);
  }
  .final-cta p {
    opacity: 0.95;
    margin-bottom: var(--space-4);
  }
  .final-cta .small-note {
    font-size: 0.8rem;
    opacity: 0.8;
    margin-top: var(--space-4);
  }
  .content-panel .venue-intel-grid {
    margin-top: var(--space-3);
  }
</style>
