---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Layout from '../../layouts/Layout.astro';
import { areas, business, contact, localIntelligence } from '../../data/site';
import ReviewsGrid from '../../components/ReviewsGrid.astro';
import StatStrip from '../../components/StatStrip.astro';

export const prerender = true;

export function getStaticPaths() {
  const supportedAreas = Object.keys(localIntelligence);
  return areas
    .filter((a) => supportedAreas.includes(a.slug))
    .map((area) => ({ params: { slug: area.slug } }));
}

const { slug } = Astro.params;
const area = areas.find((a) => a.slug === slug)!;
const intel = localIntelligence[slug];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? business.url;

// === NEW: Area-specific hero images using the new Pexels school disco photography collection ===
// Each of the 8 pages gets a distinct, high-quality visual to boost engagement & uniqueness
const schoolDiscoHeroImages: Record<string, { src: string; alt: string }> = {
  'tameside': {
    src: '/images/services/school-discos/school-disco-disco-ball-crowd-6982436.jpg',
    alt: `Excited children dancing under a sparkling disco ball at a fun school disco in Tameside`
  },
  'ashton-under-lyne': {
    src: '/images/services/school-discos/school-disco-teens-dancing-lights-12283305.jpg',
    alt: `Teens dancing under colourful lights at an energetic school disco in Ashton-under-Lyne`
  },
  'hyde': {
    src: '/images/services/school-discos/school-disco-disco-ball-crowd-6982436.jpg',
    alt: `Kids and teachers enjoying a safe, lively disco ball school disco in Hyde`
  },
  'stalybridge': {
    src: '/images/services/school-discos/school-disco-teens-dancing-lights-12283305.jpg',
    alt: `Young people dancing and having fun at a Stalybridge school disco with pro lighting`
  },
  'stockport': {
    src: '/images/services/school-discos/school-disco-disco-ball-crowd-6982436.jpg',
    alt: `Large crowd of children under the disco ball at a popular Stockport school disco`
  },
  'oldham': {
    src: '/images/services/school-discos/school-disco-teens-dancing-lights-12283305.jpg',
    alt: `Teens and primary kids dancing the night away at an Oldham school disco event`
  },
  'manchester': {
    src: '/images/services/school-discos/school-disco-disco-ball-crowd-6982436.jpg',
    alt: `Joyful school disco crowd dancing under disco ball in a Manchester school hall`
  },
  'altrincham': {
    src: '/images/services/school-discos/school-disco-teens-dancing-lights-12283305.jpg',
    alt: `Stylish school disco with teens dancing in the lights at an Altrincham school`
  },
};
const heroImage = schoolDiscoHeroImages[slug] || { 
  src: '/images/services/school-discos/school-disco-disco-ball-crowd-6982436.jpg', 
  alt: `Children dancing at a safe and fun school disco in ${area.name}` 
};

const nearbyList = (intel.nearbyAreas || [])
  .map((ns) => areas.find((a) => a.slug === ns))
  .filter((a): a is NonNullable<typeof areas[number]> => Boolean(a));

// Derived unique content — powers strong, area-specific meta titles & descriptions (and will power more content later)
const venueList = intel.venues.map((v) => v.name).join(' and ');
const topRequests = intel.crowdProfile.requests.slice(0, 3).join(', ');
const crowdVibe = intel.crowdProfile.vibe;
const typicalCrowd = intel.crowdProfile.typicalAges;
const primaryVenue = intel.venues[0];
const milestoneInsight = `School discos in ${area.name} need strictly age-appropriate music, safe energy and fun activities that keep kids happy while teachers and parents stay relaxed.`;
const hasStories = intel.stories.length > 0;
const logisticsSummary = intel.logistics.map((l) => l.detail).join(' ');

// === NEW: Area-tailored FAQ for SEO ===
const areaFAQs = [
  {
    q: `What music and activities do you use for school discos in ${area.name}?`,
    a: `${milestoneInsight} We have years of experience with local schools.`
  },
  {
    q: `How do you ensure safety and smooth logistics at ${area.name} school halls?`,
    a: `${logisticsSummary} We are DBS-checked, fully insured and communicate clearly with staff.`
  },
  {
    q: `Can parents and teachers request specific (age-appropriate) songs for ${area.name} school events?`,
    a: `Yes — we handle requests safely and keep everything suitable for the age group while still fun.`
  },
];
if (intel.logistics.length > 0) {
  areaFAQs.push({ q: `What do schools in ${area.name} need to know before booking?`, a: `We arrive early, set up professionally and deliver a safe, memorable night.` });
}

// Enhanced Schema for SEO
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'School Disco DJ Hire',
  provider: {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}/#business`,
    name: business.name,
  },
  areaServed: {
    '@type': 'Place',
    name: area.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: area.name,
      addressRegion: business.addressRegion,
      addressCountry: business.addressCountry,
    },
  },
  name: `School Disco DJs in ${area.name} | Safe & Fun`,
  description: `Safe, fun school disco DJs in ${area.name}. ${intel.localPride} 35+ years. Age-appropriate music at local schools and ${venueList}. DBS-checked team.`,
  url: `${siteUrl}/school-disco-djs/${area.slug}/`,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: areaFAQs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<Layout
  title={`School Disco DJs in ${area.name} | TeeJays Disco`}
  description={`${intel.localPride} Safe, fun school disco DJs in ${area.name} with 35+ years experience working with kids. ${typicalCrowd} events at local schools and halls like ${venueList}. Age-appropriate music, games and energy that ${crowdVibe}. Full pro setup and DBS-checked team. Serving ${area.name} and Greater Manchester.`}
>
  <!-- Preload the LCP hero image for this specific area+service page to improve mobile Core Web Vitals (LCP) -->
  <link slot="head" rel="preload" as="image" href={heroImage.src} fetchpriority="high" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <main class="page">
    <Header />

    <!-- Prominent phone-first conversion bar — visible immediately for highest mobile conversion on school disco location pages -->
    <div class="top-phone-cta">
      <div class="top-phone-inner">
        <span class="top-phone-label">Your local {area.name} school disco DJs — call now</span>
        <a class="top-phone-link" href={contact.phoneHref}>
          <Icon name="phone" /> <strong>{contact.phone}</strong>
        </a>
        <a class="top-phone-link whatsapp" href={contact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> WhatsApp Tony &amp; John
        </a>
        <span class="top-phone-urgency">Most popular {area.name} school disco dates (end-of-term &amp; Christmas) book 1–3 months ahead — secure yours</span>
      </div>
    </div>

    <PageHero
      title={`School Disco DJs in ${area.name}`}
      subtitle={`Safe, controlled, and actually fun for the kids.`}
      image={heroImage.src}
      imageAlt={heroImage.alt}
      ctas={[
        { label: `Check ${area.name} school disco availability`, href: '/contact/', icon: 'calendar', variant: 'primary' },
        { label: `Call Tony & John: ${contact.phone}`, href: contact.phoneHref, icon: 'phone', variant: 'ghost' },
        { label: 'WhatsApp us now', href: contact.whatsappHref, icon: 'whatsapp', variant: 'whatsapp' },
      ]}
    />

    <section class="section">
      <Breadcrumbs items={[{ label: 'School Disco DJs', href: '/school-disco-djs/' }, { label: area.name }]} />

      <div class="content-panel">
        <div class="content-card">
          <h2>School Disco DJs in {area.name} who know how to run the night</h2>
          <p class="lede">{intel.localPride}</p>
          <p>
            School discos in {area.name} are high-energy events that need proper control. We play current music the children actually want while keeping behaviour safe and the night enjoyable for teachers and parents too.
          </p>
          <ul class="check-list">
            <li><span><Icon name="check" /></span>Strictly age-appropriate music only</li>
            <li><span><Icon name="check" /></span>Experience managing large groups of excited children</li>
            <li><span><Icon name="check" /></span>Interactive moments, games and requests handled safely</li>
            <li><span><Icon name="check" /></span>Reliable setup and clear communication with the school</li>
          </ul>

          <!-- Primary phone + form CTA right after value props for immediate conversion on mobile -->
          <div class="cta-group primary-conversion">
            <a class="button primary button-lg" href="/contact/">
              <Icon name="calendar" />
              Check School Disco Availability in {area.name}
            </a>
            <a class="button ghost button-lg" href={contact.phoneHref}>
              <Icon name="phone" />
              Call Tony &amp; John now: {contact.phone}
            </a>
          </div>
          <p class="cta-note"><strong>Most popular {area.name} school disco dates (especially end-of-term and Christmas) book 2–4 months ahead.</strong> Secure experienced children’s DJs who keep it fun and safe — enquire today.</p>
        </div>

        <div class="content-card">
          <h2>Venues we know for school discos in {area.name}</h2>
          {intel.venues.length > 0 ? (
            <div class="venue-intel-grid">
              {intel.venues.map((venue) => (
                <div class="venue-intel-card">
                  <div class="venue-header">
                    <strong>{venue.name}</strong>
                    <span class="venue-type">{venue.type.replace('-', ' ')}</span>
                  </div>
                  <p class="venue-notes">{venue.notes}</p>

                  <div class="venue-specs">
                    {venue.capacity && <div><span>Capacity</span> {venue.capacity}</div>}
                    <div><span>Parking</span> {venue.parking}</div>
                    <div><span>Power</span> {venue.power}</div>
                    <div><span>Loading</span> {venue.loading}</div>
                  </div>

                  {venue.musicFit && <p class="venue-music"><strong>Music fit:</strong> {venue.musicFit}</p>}
                  {venue.lastPlayed && <p class="venue-story"><em>{venue.lastPlayed}</em></p>}
                </div>
              ))}
            </div>
          ) : (
            <p>We regularly play school discos across {area.name} in school halls, sports centres and community venues. Ask us about your school.</p>
          )}

          <!-- Stronger post-venues conversion CTA with phone for school organisers -->
          <div class="venue-cta">
            <p><strong>Know the school hall but want DJs who actually know how to run safe, high-energy {area.name} school discos?</strong> We’ve powered up the decks at these exact venues and know exactly how to keep the kids dancing, the teachers happy, and the night running smoothly from start to finish.</p>
            <div class="cta-group">
              <a class="button primary" href="/contact/">
                <Icon name="calendar" /> Check {area.name} school disco availability
              </a>
              <a class="button ghost" href={contact.phoneHref}>
                <Icon name="phone" /> Call us: {contact.phone}
              </a>
            </div>
            <p class="cta-note" style="margin-top: var(--space-3);"><strong>2–4 months is typical</strong> for the best {area.name} school disco dates. Your date is filling up — reach us today.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <SectionTitle title={`Other family event options in ${area.name}`} subtitle="Safe, fun entertainment that works for the whole community." />
      <div class="area-link-grid">
        <a class="area-link-card" href={`/birthday-party-djs/${slug}/`}>
          <Icon name="cake" />
          <span>Birthday Party DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/community-djs/${slug}/`}>
          <Icon name="group" />
          <span>Community Events in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/anniversary-djs/${slug}/`}>
          <Icon name="heart" />
          <span>Anniversary DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/wedding-djs/${slug}/`}>
          <Icon name="rings" />
          <span>Wedding DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href="/school-disco-djs/">
          <Icon name="graduate" />
          <span>See all School Disco areas</span>
        </a>
      </div>
    </section>

    {nearbyList.length > 0 && (
      <section class="section">
        <SectionTitle title={`School Disco DJs in nearby towns`} subtitle="Age-appropriate, energetic entertainment for schools and youth groups across the area." />
        <div class="area-link-grid">
          {nearbyList.map((nearArea) => (
            <a class="area-link-card" href={`/school-disco-djs/${nearArea.slug}/`}>
              <Icon name="graduate" />
              <span>School Discos in {nearArea.name}</span>
            </a>
          ))}
          <a class="area-link-card" href="/school-disco-djs/">
            <Icon name="graduate" />
            <span>All School Disco areas</span>
          </a>
        </div>
      </section>
    )}

    <!-- Final high-visibility phone CTA + urgency for conversion -->
    <section class="section trust-final">
      <div class="final-cta">
        <h3>Ready to book school disco DJs who make {area.name} kids’ nights unforgettable (and safe)?</h3>
        <p>Call Tony &amp; John or send an enquiry. We’ll talk through your school hall, expected numbers, preferred music, games, and how to keep the energy perfect while staying in full control.</p>
        <div class="cta-group">
          <a class="button primary button-lg" href={contact.phoneHref}>
            <Icon name="phone" /> Call {contact.phone}
          </a>
          <a class="button ghost button-lg" href="/contact/">Send enquiry for {area.name} school disco</a>
        </div>
        <p class="small-note">Based in Tameside. Covering {area.name} and Greater Manchester. Fully insured. 35+ years trusted experience with children’s events. DBS-checked, reliable, and loved by schools.</p>
      </div>
    </section>

    <!-- Pre-filled school disco + safe context note for parent/organiser lead capture -->
    <ContactBlock 
      faq={false} 
      defaultEventType="School Disco"
      headline={`Ready to book ${area.name} school disco DJs?`}
      subtitle={`Tell us your date, school/venue and age group. Trusted local ${area.name} DJs confirm availability fast — safe, fun, age-appropriate.`}
      contextNote={`Reliable ${area.name} school disco specialists — age-appropriate playlists, fully insured and experienced with young crowds.`}
      source={`school-disco-djs-${slug}`}
    />
    <Footer />
  </main>
</Layout>

<style>
  .lede { font-size: 1.1rem; font-weight: 600; color: var(--ink); }
  .venue-intel-grid { display: grid; gap: var(--space-5); margin-top: var(--space-4); }
  @media (min-width: 720px) { .venue-intel-grid { grid-template-columns: repeat(2, 1fr); } }
  .venue-intel-card { background: var(--paper-2); border: 2px solid var(--ink); border-radius: var(--radius-md); padding: var(--space-5); box-shadow: var(--shadow-soft); }
  .venue-header { display: flex; justify-content: space-between; margin-bottom: var(--space-3); }
  .venue-header strong { font-size: 1.1rem; }
  .venue-notes { font-size: 0.95rem; line-height: 1.5; margin-bottom: var(--space-4); }
  .venue-specs { display: grid; grid-template-columns: 1fr; gap: var(--space-2); font-size: 0.85rem; margin-bottom: var(--space-3); }
  .venue-specs div { display: flex; gap: var(--space-2); }
  .venue-specs span { font-weight: 600; min-width: 70px; color: var(--pink); }
  .venue-music { font-size: 0.9rem; margin: 0; }
  .venue-type {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--ink);
    color: var(--paper);
    padding: 2px 8px;
    border-radius: 9999px;
  }
  .venue-story {
    font-size: 0.9rem;
    margin: 0;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Phone CTA & Urgency styles — consistent prominent tap-friendly CTAs + real booking pressure on every school disco page */
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .cta-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
    font-style: italic;
  }
  .venue-cta {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: linear-gradient(145deg, var(--paper), var(--paper-2));
    border: 2px solid var(--pink);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .venue-cta p {
    margin-bottom: var(--space-3);
    font-size: 0.95rem;
  }
  .trust-final {
    text-align: center;
  }
  .final-cta {
    max-width: 720px;
    margin: var(--space-6) auto 0;
    padding: var(--space-6);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-lg);
  }
  .final-cta h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin-bottom: var(--space-3);
    color: var(--paper);
  }
  .final-cta p {
    opacity: 0.95;
    margin-bottom: var(--space-4);
  }
  .final-cta .small-note {
    font-size: 0.8rem;
    opacity: 0.8;
    margin-top: var(--space-4);
  }
  .content-panel .venue-intel-grid {
    margin-top: var(--space-3);
  }
</style>
