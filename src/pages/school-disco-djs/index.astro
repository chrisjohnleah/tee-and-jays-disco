---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import ReviewsGrid from '../../components/ReviewsGrid.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import StatStrip from '../../components/StatStrip.astro';
import Layout from '../../layouts/Layout.astro';
import { areas, business, contact, localIntelligence } from '../../data/site';

export const prerender = true;

const supportedSlugs = Object.keys(localIntelligence);
const supportedAreas = areas.filter((a) => supportedSlugs.includes(a.slug));

const areaCards = supportedAreas.map((area) => {
  const intel = localIntelligence[area.slug];
  const venueCount = intel?.venues?.length ?? 0;
  const sampleVenue = intel?.venues?.[0]?.name ?? '';
  return {
    slug: area.slug,
    name: area.name,
    pride: intel?.localPride || area.description,
    venueCount,
    sampleVenue,
  };
});
---

<Layout
  title="School Disco DJs across Tameside, Manchester & the North West | TeeJays Disco"
  description="Safe, fun, age-appropriate school disco DJs in Tameside, Stockport, Oldham & Manchester. We know the local school halls, keep perfect control and play the tracks kids love. Teachers book us repeatedly. Get your quote."
>
  <main class="page">
    <Header />
    <PageHero
      title="School Disco DJs who keep it fun and safe"
      subtitle="Tony & John — 35+ years each. We bring the energy kids love while staying fully in control for teachers and parents."
      image="/images/services/school-discos/school-disco-teens-dancing-lights-12283305.jpg"
      imageAlt="Excited children and teens dancing at a lively school disco with lights at a TeeJays Disco event in Greater Manchester"
    />

    <StatStrip />

    <section class="section">
      <Breadcrumbs items={[{ label: 'School Disco DJs' }]} />

      <div class="content-panel">
        <div class="content-card">
          <h2>School Disco DJs who deliver fun without the stress for teachers</h2>
          <p>
            Every school hall has its quirks — power, echo, loading, strict finish times. We know the local ones. Parents want safe, age-appropriate fun; kids want the tracks they actually love. We strike the perfect balance: current chart hits (edited for school), high energy, games, and total control so the night ends on a high with no issues.
          </p>
          <ul class="check-list">
            <li><span><Icon name="check" /></span>Strictly age-appropriate playlists — no explicit lyrics, ever</li>
            <li><span><Icon name="check" /></span>Proven at controlling large excited groups safely and happily</li>
            <li><span><Icon name="check" /></span>Reliable, punctual and professional with schools — we know the timings</li>
            <li><span><Icon name="check" /></span>Interactive games, spot prizes and moments so even shy kids join in</li>
          </ul>
          <p style="margin-top: var(--space-4);">
            <a href="#contact" class="button primary">Book your school disco</a>
            <a href={contact.phoneHref} class="button ghost" style="margin-left: 12px;">Call {contact.phone}</a>
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <SectionTitle title="School Disco DJs in 8 priority towns" subtitle="Real local hall intelligence for safe, high-energy school discos. Every area page covers the exact school and community spaces we know and the music kids actually request." />

      <div class="area-list-grid">
        {areaCards.map((card) => (
          <a class="area-list-card" href={`/school-disco-djs/${card.slug}/`}>
            <div class="area-list-icon"><Icon name="graduate" /></div>
            <h3>School Disco DJs in {card.name}</h3>
            <p>{card.pride}{card.venueCount > 0 ? ` — ${card.venueCount} venues we know inside-out.` : ''}</p>
            {card.sampleVenue && <p style="font-size:0.85rem; opacity:0.75; margin-top:4px;">Featured: {card.sampleVenue}</p>}
            <span class="area-list-cta">See venues, music &amp; approach →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <SectionTitle title="How we run school discos differently" subtitle="Not a kids’ playlist on shuffle — safe, high-energy entertainment teachers trust." />

      <div class="content-panel">
        <div class="content-card">
          <h2>School-specific planning</h2>
          <p>We speak to the school in advance about power points, hall size, numbers, finish time and behaviour expectations. We know which local school halls load easily and which need extra planning. No last-minute surprises.</p>
        </div>
        <div class="content-card">
          <h2>Age-appropriate bangers + games</h2>
          <p>Current chart and TikTok favourites the kids actually request (edited for school). Plus fun throwbacks, spot prizes and interactive moments so even the shy kids get involved and have a brilliant night.</p>
        </div>
        <div class="content-card">
          <h2>Teachers love us</h2>
          <p>Local schools book us repeatedly. Clear communication, sensible volume, professional hand-over exactly on time. We bring the fun so staff can relax and enjoy watching the children have the time of their lives.</p>
        </div>
      </div>
    </section>

    <ReviewsGrid limit={3} title="What schools say about our disco DJs" />

    <section class="section">
      <SectionTitle title="Other family and community events we cover" subtitle="Safe, fun, age-appropriate or family-friendly entertainment for birthdays, gatherings and more." />
      <div class="area-link-grid">
        <a class="area-link-card" href="/wedding-djs/">
          <Icon name="rings" />
          <span>Wedding DJs</span>
        </a>
        <a class="area-link-card" href="/birthday-party-djs/">
          <Icon name="cake" />
          <span>Birthday Party DJs</span>
        </a>
        <a class="area-link-card" href="/anniversary-djs/">
          <Icon name="heart" />
          <span>Anniversary DJs</span>
        </a>
        <a class="area-link-card" href="/corporate-djs/">
          <Icon name="briefcase" />
          <span>Corporate Event DJs</span>
        </a>
        <a class="area-link-card" href="/pub-club-djs/">
          <Icon name="music" />
          <span>Pub &amp; Club Night DJs</span>
        </a>
        <a class="area-link-card" href="/community-djs/">
          <Icon name="group" />
          <span>Community Event DJs</span>
        </a>
        <a class="area-link-card" href="/areas/">
          <Icon name="pin" />
          <span>Browse all areas we cover</span>
        </a>
      </div>
    </section>

    <ContactBlock faq={false} />
    <Footer />
  </main>
</Layout>
