---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactBlock from '../components/ContactBlock.astro';
import FaqList from '../components/FaqList.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Layout from '../layouts/Layout.astro';
import { faqs } from '../data/site';

export const prerender = true;

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};
---

<Layout title="FAQ | TeeJays Disco" description="Answers to common TeeJays Disco booking questions, including prices, areas, music and setup.">
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<main class="page">
		<Header />
		<PageHero
			title="Questions before you book"
			subtitle="Straight answers on pricing, travel, setup, music choices and what we need from your venue."
		/>
		<section class="section">
			<Breadcrumbs items={[{ label: 'FAQ' }]} />
			<FaqList showAnswers />
		</section>
		<ContactBlock faq={false} />
		<Footer />
	</main>
</Layout>
