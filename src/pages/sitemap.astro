---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Layout from '../layouts/Layout.astro';
import { areas, localIntelligence, services } from '../data/site';

export const prerender = true;

const supportedAreas = areas.filter((area) => Object.keys(localIntelligence).includes(area.slug));
const localEventHubs = [
	{ label: 'Wedding DJs', href: '/wedding-djs/' },
	{ label: 'Birthday Party DJs', href: '/birthday-party-djs/' },
	{ label: 'Anniversary DJs', href: '/anniversary-djs/' },
	{ label: 'Corporate DJs', href: '/corporate-djs/' },
	{ label: 'School Disco DJs', href: '/school-disco-djs/' },
	{ label: 'Pub & Club DJs', href: '/pub-club-djs/' },
	{ label: 'Community DJs', href: '/community-djs/' },
];
---

<Layout
	title="Sitemap | TeeJays Disco"
	description="Full site map for TeeJays Disco — every page, service and area we cover, in one place."
>
	<main class="page">
		<Header />
		<PageHero title="Sitemap" subtitle="Every page on the TeeJays Disco site." />

		<section class="section">
			<Breadcrumbs items={[{ label: 'Sitemap' }]} />

			<div class="sitemap-grid">
				<div class="sitemap-col">
					<h2>Main Pages</h2>
					<ul>
						<li><a href="/">Home</a></li>
						<li><a href="/about/">About</a></li>
						<li><a href="/gallery/">Gallery</a></li>
						<li><a href="/reviews/">Reviews</a></li>
						<li><a href="/faq/">FAQ</a></li>
						<li><a href="/contact/">Contact</a></li>
					</ul>
				</div>

				<div class="sitemap-col">
					<h2>Event Pages</h2>
					<ul>
						{localEventHubs.map((hub) => (
							<li><a href={hub.href}>{hub.label}</a></li>
						))}
					</ul>
				</div>

				<div class="sitemap-col">
					<h2>Service Guides</h2>
					<ul>
						<li><a href="/services/">All Services</a></li>
						{services.map((service) => (
							<li><a href={`/services/${service.slug}/`}>{service.title}</a></li>
						))}
					</ul>
				</div>

				<div class="sitemap-col">
					<h2>Local Wedding DJ Pages</h2>
					<ul>
						{supportedAreas.map((area) => (
							<li><a href={`/wedding-djs/${area.slug}/`}>Wedding DJs in {area.name}</a></li>
						))}
					</ul>
				</div>

				<div class="sitemap-col">
					<h2>Local Birthday Party Pages</h2>
					<ul>
						{supportedAreas.map((area) => (
							<li><a href={`/birthday-party-djs/${area.slug}/`}>Birthday Party DJs in {area.name}</a></li>
						))}
					</ul>
				</div>

				<div class="sitemap-col">
					<h2>Local Corporate DJ Pages</h2>
					<ul>
						{supportedAreas.map((area) => (
							<li><a href={`/corporate-djs/${area.slug}/`}>Corporate DJs in {area.name}</a></li>
						))}
					</ul>
				</div>

				<div class="sitemap-col">
					<h2>Areas Covered</h2>
					<ul>
						<li><a href="/areas/">All Areas</a></li>
						{areas.map((area) => (
							<li><a href={`/areas/${area.slug}/`}>Mobile DJ in {area.name}</a></li>
						))}
					</ul>
				</div>

				<div class="sitemap-col">
					<h2>Legal</h2>
					<ul>
						<li><a href="/privacy/">Privacy Policy</a></li>
						<li><a href="/terms/">Terms &amp; Conditions</a></li>
					</ul>
				</div>
			</div>

			<p class="sitemap-xml-note">
				Looking for the machine-readable XML sitemap? It's at <a href="/sitemap-index.xml">/sitemap-index.xml</a>.
			</p>
		</section>

		<Footer />
	</main>
</Layout>
