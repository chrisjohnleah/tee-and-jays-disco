---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Layout from '../../layouts/Layout.astro';
import { areas, business, contact, localIntelligence } from '../../data/site';
import ReviewsGrid from '../../components/ReviewsGrid.astro';
import StatStrip from '../../components/StatStrip.astro';

export const prerender = true;

export function getStaticPaths() {
  const supportedAreas = Object.keys(localIntelligence);
  return areas
    .filter((a) => supportedAreas.includes(a.slug))
    .map((area) => ({ params: { slug: area.slug } }));
}

const { slug } = Astro.params;
const area = areas.find((a) => a.slug === slug)!;
const intel = localIntelligence[slug];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? business.url;

// Derived unique content for this specific area — makes every page feel different
const primaryVenue = intel.venues[0];
const venueList = intel.venues.map((v) => v.name).join(' and ');
const topRequests = intel.crowdProfile.requests.slice(0, 3).join(', ');
const crowdVibe = intel.crowdProfile.vibe;
const typicalCrowd = intel.crowdProfile.typicalAges;
const milestoneInsight = intel.milestoneTips || `We always ask for the story behind the anniversary — the original wedding song or a family favourite that still means everything to the couple.`;
const hasStories = intel.stories.length > 0;
const logisticsSummary = intel.logistics.map((l) => l.detail).join(' ');

const nearbyList = (intel.nearbyAreas || [])
  .map((ns) => areas.find((a) => a.slug === ns))
  .filter((a): a is NonNullable<typeof areas[number]> => Boolean(a));

// === NEW: Area-tailored FAQ content for SEO (long-tail keywords) + conversion trust ===
// Pulls directly from rich localIntelligence (venues, logistics, milestoneTips, crowdProfile)
const areaFAQs = [
  {
    q: `What songs work best for ${area.name} anniversary celebrations?`,
    a: `${milestoneInsight} We’ve played at ${venueList} and know exactly what ${crowdVibe} crowds in ${area.name} respond to on milestone nights.`
  },
  {
    q: `How do you handle curfews, loading and timing at ${area.name} venues for anniversaries?`,
    a: `${logisticsSummary} We build the entire night backwards from your chosen finish time so the dancefloor is still full when the lights come up.`
  },
  {
    q: `Will you play the specific requests our ${area.name} guests want for the anniversary?`,
    a: `Yes — ${area.name} crowds love ${topRequests} and we read the room perfectly. Nothing feels like a generic USB playlist. Every set is built for the people celebrating that night.`
  },
];
if (intel.logistics.length > 0) {
  areaFAQs.push({
    q: `What’s the biggest thing families worry about with anniversary DJs in ${area.name}?`,
    a: `${intel.logistics[0].detail} We’ve played these rooms dozens of times — you get zero surprises and maximum dancefloor for your celebration.`
  });
}

// === NEW: Area-specific hero images using the new Pexels anniversary photography collection ===
// Each of the 8 pages gets a distinct, high-quality visual to boost engagement & uniqueness
const anniversaryHeroImages: Record<string, { src: string; alt: string }> = {
  'tameside': {
    src: '/images/services/anniversaries/anniversary-family-dancing-together-6518005.jpg',
    alt: `Multi-generational family dancing together at a joyful Tameside anniversary celebration with TeeJays`
  },
  'ashton-under-lyne': {
    src: '/images/services/anniversaries/anniversary-family-dancing-together-6518005.jpg',
    alt: `Extended family celebrating a special anniversary with dancing in Ashton-under-Lyne`
  },
  'hyde': {
    src: '/images/services/anniversaries/anniversary-family-dancing-together-6518005.jpg',
    alt: `Happy family members of all ages on the dancefloor at a Hyde anniversary party`
  },
  'stalybridge': {
    src: '/images/services/anniversaries/anniversary-family-dancing-together-6518005.jpg',
    alt: `Warm family dancing at a heartfelt Stalybridge anniversary milestone`
  },
  'stockport': {
    src: '/images/services/anniversaries/anniversary-senior-couple-hands-6788000.jpg',
    alt: `Senior couple holding hands and celebrating their anniversary in Stockport — emotional and elegant`
  },
  'oldham': {
    src: '/images/services/anniversaries/anniversary-family-dancing-together-6518005.jpg',
    alt: `Large family group dancing and celebrating an anniversary in Oldham`
  },
  'manchester': {
    src: '/images/services/anniversaries/anniversary-senior-couple-hands-6788000.jpg',
    alt: `Elegant senior couple at a refined Manchester anniversary celebration`
  },
  'altrincham': {
    src: '/images/services/anniversaries/anniversary-senior-couple-hands-6788000.jpg',
    alt: `Sophisticated anniversary moment for a senior couple in Altrincham`
  },
};
const heroImage = anniversaryHeroImages[slug] || { 
  src: '/images/services/anniversaries/anniversary-family-dancing-together-6518005.jpg', 
  alt: `Family celebrating a milestone anniversary with dancing in ${area.name}` 
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Anniversary DJ Hire',
  provider: {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}/#business`,
    name: business.name,
  },
  areaServed: {
    '@type': 'Place',
    name: area.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: area.name,
      addressRegion: business.addressRegion,
      addressCountry: business.addressCountry,
    },
  },
  name: `Anniversary DJs in ${area.name}`,
  description: `Professional anniversary DJs in ${area.name}. ${intel.localPride} 35+ years experience. Milestone celebration specialists with deep local knowledge of venues including ${venueList}. Tailored music for ${typicalCrowd} crowds who love ${topRequests}.`,
  url: `${siteUrl}/anniversary-djs/${area.slug}/`,
};

// FAQ schema for rich results in Google (huge SEO win for these pages)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: areaFAQs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<Layout
  title={`Anniversary DJs in ${area.name} | TeeJays Disco`}
  description={`${intel.localPride} Professional anniversary DJs in ${area.name} with 35+ years experience. Milestone celebration specialists who know the local venues and ${crowdVibe} crowds. Full sound, lighting & warm MC. Serving ${area.name} and Greater Manchester.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Preload the LCP hero image for this specific area+service page to improve mobile Core Web Vitals (LCP) -->
  <link slot="head" rel="preload" as="image" href={heroImage.src} fetchpriority="high" />

  <main class="page">
    <Header />

    <!-- Prominent phone-first conversion bar — visible immediately for highest mobile conversion on anniversary location pages -->
    <div class="top-phone-cta">
      <div class="top-phone-inner">
        <span class="top-phone-label">Your local {area.name} anniversary DJs — call now</span>
        <a class="top-phone-link" href={contact.phoneHref}>
          <Icon name="phone" /> <strong>{contact.phone}</strong>
        </a>
        <a class="top-phone-link whatsapp" href={contact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> WhatsApp Tony &amp; John
        </a>
        <span class="top-phone-urgency">Most popular {area.name} milestone dates book 3–6 months ahead — secure yours</span>
      </div>
    </div>

    <PageHero
      title={`Anniversary DJs in ${area.name}`}
      subtitle={`${intel.localPride} Milestone celebration specialists who know the venues, the crowds, and how to make the night feel exactly right.`}
      image={heroImage.src}
      imageAlt={heroImage.alt}
      ctas={[
        { label: `Check ${area.name} anniversary availability`, href: '/contact/', icon: 'calendar', variant: 'primary' },
        { label: `Call Tony & John: ${contact.phone}`, href: contact.phoneHref, icon: 'phone', variant: 'ghost' },
        { label: 'WhatsApp us now', href: contact.whatsappHref, icon: 'whatsapp', variant: 'whatsapp' },
      ]}
    />

    <section class="section">
      <Breadcrumbs items={[{ label: 'Anniversary DJs', href: '/anniversary-djs/' }, { label: area.name }]} />

      <div class="content-panel">
        <div class="content-card">
          <h2>Anniversary DJs in {area.name} who understand the moment</h2>
          <p class="lede">{intel.localPride}</p>
          <p>
            Milestone anniversaries in {area.name} bring together {typicalCrowd}. These are {crowdVibe} crowds who love {topRequests} and more.
            The best nights happen when the music feels like it belongs in the room — not a generic playlist dropped from a USB.
            We’ve played dozens of anniversaries right here and know exactly which rooms work, how the crowds move, and how to pace a night so three generations stay on the floor together.
          </p>

          <div class="trust-row">
            <div class="trust-item"><Icon name="star" /> <span>35+ years each</span></div>
            <div class="trust-item"><Icon name="pin" /> <span>Deep {area.name} knowledge</span></div>
            <div class="trust-item"><Icon name="shield" /> <span>Fully insured &amp; PAT tested</span></div>
            <div class="trust-item"><Icon name="speaker" /> <span>Pro sound + lighting</span></div>
          </div>

          <ul class="check-list">
            <li><span><Icon name="check" /></span>Milestone specialists — we ask for the story, not just the song title</li>
            <li><span><Icon name="check" /></span>We read {crowdVibe} crowds perfectly and adapt the energy all night</li>
            <li><span><Icon name="check" /></span>Full professional sound, lighting and warm, friendly hosting</li>
            <li><span><Icon name="check" /></span>Real hands-on experience at the venues listed below</li>
          </ul>

          <div class="cta-group">
            <a class="button primary" href="/contact/">
              <Icon name="calendar" />
              Check Anniversary Availability in {area.name}
            </a>
            <a class="button ghost" href={contact.phoneHref}>
              <Icon name="phone" />
              Call Tony &amp; John: {contact.phone}
            </a>
          </div>
          <p class="cta-note">Most popular {area.name} anniversary dates book months ahead. Get in touch early.</p>
        </div>

        <div class="content-card">
          <h2>Venues we know for anniversaries in {area.name}</h2>
          <p>These are the rooms we’ve actually played, loaded into, powered up, and learned the quirks of. Real details matter on an anniversary night — and we’ve done the homework so you don’t have surprises.</p>

          {intel.venues.length > 0 ? (
            <div class="venue-intel-grid">
              {intel.venues.map((venue) => (
                <div class="venue-intel-card">
                  <div class="venue-header">
                    <strong>{venue.name}</strong>
                    <span class="venue-type">{venue.type.replace('-', ' ')}</span>
                  </div>
                  <p class="venue-notes">{venue.notes}</p>

                  <div class="venue-specs">
                    {venue.capacity && <div><span>Capacity</span> {venue.capacity}</div>}
                    <div><span>Parking</span> {venue.parking}</div>
                    <div><span>Power</span> {venue.power}</div>
                    <div><span>Loading</span> {venue.loading}</div>
                  </div>

                  {venue.musicFit && <p class="venue-music"><strong>Music fit:</strong> {venue.musicFit}</p>}
                  {venue.lastPlayed && <p class="venue-story"><em>{venue.lastPlayed}</em></p>}
                </div>
              ))}
            </div>
          ) : (
            <p>We regularly play anniversaries across {area.name} in hotels, function rooms, town halls and private homes. Ask us about your venue.</p>
          )}

          <a class="inline-cta" href="/contact/">Not seeing your venue? Tell us about it →</a>
        </div>
      </div>
    </section>

    <section class="section">
      <SectionTitle title={`Music that works for anniversaries in ${area.name}`} subtitle="Not a generic playlist — the right songs for the people who actually live here." />

      <div class="music-prefs">
        {intel.musicNotes.map((note) => (
          <div class="music-note">
            <div class="music-decade">{note.decade}</div>
            <div class="music-genres">{note.genres.join(' · ')}</div>
            <p>{note.whyItWorks}</p>
          </div>
        ))}
      </div>
      <p class="music-tail">We build every set around {topRequests} and the energy of the actual room — never the same set twice.</p>
    </section>

    <section class="section">
      <SectionTitle title={`What makes a great anniversary night in ${area.name}`} subtitle="Local realities that turn a good night into an unforgettable one." />

      <div class="content-panel three-col">
        <div class="content-card">
          <h2>Local crowd knowledge</h2>
          <p>{crowdVibe} crowds in {area.name} — typically {typicalCrowd} — tend to respond best to {intel.musicNotes[0]?.genres.join(', ')} early on. We know exactly when to push the energy and when to let it breathe so the whole room stays involved.</p>
        </div>
        <div class="content-card">
          <h2>Venue realities</h2>
          <p>We’ve loaded into, powered up, and played in the actual rooms you’re considering — {venueList}. That means fewer surprises on the day, perfect sound levels, and smooth transitions between speeches and dancing.</p>
        </div>
        <div class="content-card">
          <h2>Timing that actually works</h2>
          <p>{logisticsSummary} We plan the night backwards from the end so the dancefloor is still full when the lights come on — no awkward early wind-downs.</p>
        </div>
      </div>

      <div class="local-cta-bar">
        <strong>Planning a {area.name} anniversary?</strong>
        <a class="button primary button-sm" href="/contact/">Speak to us about the right music for your crowd →</a>
      </div>
    </section>

    <section class="section">
      <SectionTitle title={`How we run anniversaries in ${area.name}`} subtitle="Local knowledge that makes the day smoother — and the music meaningful." />

      <div class="content-panel">
        <div class="content-card highlight">
          <h2>Milestone moments that actually mean something</h2>
          <p class="lede-small">{milestoneInsight}</p>
          <p>We don’t just press play. We talk to you beforehand, understand the moment, and make sure the music honours the occasion while still creating a proper party that all generations enjoy.</p>
        </div>

        <div class="content-card">
          <h2>Local logistics &amp; timing</h2>
          <ul class="check-list logistics">
            {intel.logistics.map((log) => (
              <li><span><Icon name="pin" /></span><strong>{log.label}:</strong> {log.detail}</li>
            ))}
          </ul>
          <p class="logistics-note">Every {area.name} anniversary is different — we build the timeline around your venue, your guests, and your priorities.</p>
        </div>
      </div>

      <!-- NEW: Area-specific FAQ for SEO (answer boxes in Google) and deep trust -->
      <div class="faq-section">
        <h3>Common questions from {area.name} families planning their anniversary</h3>
        <div class="faq-list">
          {areaFAQs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
        <p class="faq-cta">Still have questions? <a href={contact.phoneHref}>Call us</a> or <a href="/contact/">send a quick enquiry</a> — we’re happy to talk through your exact plans.</p>
      </div>
    </section>

    {hasStories && (
      <section class="section">
        <SectionTitle title={`Real ${area.name} anniversary moments we’ve created`} subtitle="These are the nights families still talk about years later." />
        <div class="stories-grid">
          {intel.stories.map((story) => (
            <div class="story-card">
              <p>“{story}”</p>
            </div>
          ))}
        </div>
        <p class="story-cta">Your {area.name} anniversary could be the next one we remember. <a href="/contact/">Let’s talk about it.</a></p>
      </section>
    )}

    <section class="section">
      <SectionTitle title={`More celebration options in ${area.name}`} subtitle="Same local knowledge, different kind of night." />
      <div class="area-link-grid">
        <a class="area-link-card" href={`/wedding-djs/${slug}/`}>
          <Icon name="rings" />
          <span>Wedding DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/birthday-party-djs/${slug}/`}>
          <Icon name="cake" />
          <span>Birthday Party DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href={`/corporate-djs/${slug}/`}>
          <Icon name="briefcase" />
          <span>Corporate DJs in {area.name}</span>
        </a>
        <a class="area-link-card" href="/anniversary-djs/">
          <Icon name="heart" />
          <span>See all Anniversary areas</span>
        </a>
      </div>
    </section>

    <!-- Strong trust signals and final conversion push -->
    <section class="section trust-final">
      <StatStrip />
      <ReviewsGrid limit={2} title={`What families say about our anniversary nights`} />
      <div class="final-cta">
        <h3>Ready to book anniversary DJs who actually know {area.name}?</h3>
        <p>Call us today or send an enquiry. We’ll talk through your venue, your guest list, the milestone songs that matter, and exactly what will make the night special for everyone.</p>
        <div class="cta-group">
          <a class="button primary button-lg" href={contact.phoneHref}>
            <Icon name="phone" /> Call {contact.phone}
          </a>
          <a class="button ghost button-lg" href="/contact/">Send enquiry for {area.name} anniversary</a>
        </div>
        <p class="small-note">Based in Tameside. Covering {area.name} and all of Greater Manchester. Fully insured. 35+ years trusted experience.</p>
      </div>
    </section>

    <!-- Pre-selected "Anniversary" + rich context for all anniversary+location pages lead capture -->
    <ContactBlock 
      faq={true} 
      defaultEventType="Anniversary"
      headline={`Ready to book ${area.name} anniversary DJs?`}
      subtitle={`Tell us your date, venue and special songs. Local ${area.name} experts will confirm availability & quote within 24 hours.`}
      contextNote={`You're speaking to ${area.name} locals — Tony & John know the venues and create the perfect soundtrack for milestone celebrations.`}
      source={`anniversary-djs-${slug}`}
    />
    <Footer />
  </main>
</Layout>

<style>
  .lede {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .venue-intel-grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  @media (min-width: 720px) {
    .venue-intel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .venue-intel-card {
    background: var(--paper-2);
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: var(--shadow-soft);
  }

  .venue-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .venue-header strong {
    font-size: 1.1rem;
  }

  .venue-type {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: var(--ink);
    color: var(--paper);
    padding: 2px 8px;
    border-radius: 9999px;
  }

  .venue-notes {
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: var(--space-4);
  }

  .venue-specs {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    font-size: 0.85rem;
    margin-bottom: var(--space-3);
  }

  .venue-specs div {
    display: flex;
    gap: var(--space-2);
  }

  .venue-specs span {
    font-weight: 600;
    min-width: 70px;
    color: var(--pink);
  }

  .venue-music,
  .venue-story {
    font-size: 0.9rem;
    margin: 0;
  }

  .venue-story {
    color: var(--text-muted);
    font-style: italic;
  }

  .music-prefs {
    display: grid;
    gap: var(--space-4);
    max-width: 1000px;
    margin: 0 auto;
  }

  .music-note {
    background: var(--paper-2);
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .music-decade {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--pink);
    margin-bottom: var(--space-1);
  }

  .music-genres {
    font-weight: 600;
    margin-bottom: var(--space-2);
    color: var(--cobalt);
  }

  .stories-grid {
    display: grid;
    gap: var(--space-5);
    max-width: 900px;
    margin: 0 auto;
  }

  .story-card {
    background: var(--ink);
    color: var(--paper);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .logistics li {
    align-items: flex-start;
  }

  /* === New enhanced styles for conversion & local feel === */
  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }
  .trust-item svg {
    color: var(--pink);
    flex-shrink: 0;
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .cta-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
    font-style: italic;
  }

  .inline-cta {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 600;
    color: var(--cobalt);
    text-decoration: underline;
  }
  .inline-cta:hover {
    color: var(--pink);
  }

  .three-col {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 860px) {
    .three-col {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .local-cta-bar {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--paper-2);
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    justify-content: space-between;
  }

  .content-card.highlight {
    border-color: var(--pink);
    background: linear-gradient(145deg, var(--paper), var(--paper-2));
  }

  .lede-small {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--space-2);
  }

  .logistics-note {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
  }

  .story-cta {
    text-align: center;
    margin-top: var(--space-4);
    font-size: 0.95rem;
  }

  .music-prefs + p.music-tail {
    text-align: center;
    max-width: 700px;
    margin: var(--space-4) auto 0;
    font-style: italic;
    color: var(--text-muted);
  }

  .trust-final {
    text-align: center;
  }

  .final-cta {
    max-width: 720px;
    margin: var(--space-6) auto 0;
    padding: var(--space-6);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-lg);
  }

  .final-cta h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: var(--space-3);
  }

  .final-cta p {
    opacity: 0.95;
    margin-bottom: var(--space-4);
  }

  .final-cta .small-note {
    font-size: 0.8rem;
    opacity: 0.8;
    margin-top: var(--space-4);
