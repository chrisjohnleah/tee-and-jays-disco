---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import ReviewsGrid from '../../components/ReviewsGrid.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import StatStrip from '../../components/StatStrip.astro';
import Layout from '../../layouts/Layout.astro';
import { areas, business, contact, localIntelligence } from '../../data/site';

export const prerender = true;

export function getStaticPaths() {
  // Only generate for areas that have rich localIntelligence data — every page is genuinely unique
  const supportedAreas = Object.keys(localIntelligence);
  return areas
    .filter((a) => supportedAreas.includes(a.slug))
    .map((area) => ({ params: { slug: area.slug } }));
}

const { slug } = Astro.params;
const area = areas.find((a) => a.slug === slug)!;
const intel = localIntelligence[slug];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? business.url;

// === NEW: Area-specific hero images (Pexels wedding collection) — optimized to fast-loading files only (<350KB) for instant premium feel on all devices ===
// Every wedding-djs page now uses vibrant, high-energy photos that sing with the site's maximalist neon-club aesthetic (string lights, packed dancefloors, emotional first dances). No more 2–4MB bloat.
const weddingHeroImages: Record<string, { src: string; alt: string }> = {
  'tameside': {
    src: '/images/custom-heroes/weddings/tameside-wedding-dancefloor-hero.jpg',
    alt: `Three generations of proud Tameside family filling the dancefloor in pure joy at a packed local wedding — the warm, singalong energy and community spirit that only real Tameside DJs like TeeJays can create`
  },
  'stockport': {
    src: '/images/custom-heroes/weddings/tameside-stockport-wedding-first-dance-hero.jpg',
    alt: `Emotional, beautifully lit first dance moment at a sophisticated Stockport wedding — the exact intimate, unforgettable magic TeeJays delivers for discerning Stockport couples at Bramall Hall, Town Hall and Alma Lodge`
  },
  'ashton-under-lyne': {
    src: '/images/services/weddings/wedding-bride-dancefloor-smile-12417635.jpg',
    alt: `Radiant smiling bride and happy guests lighting up the dancefloor at a warm, heartfelt Ashton-under-Lyne wedding reception — pure joy brought by TeeJays`
  },
  'hyde': {
    src: '/images/services/weddings/wedding-guests-dancing-string-lights-29569636.jpg',
    alt: `Packed dancefloor under magical string lights at a lively Hyde wedding — three generations celebrating with the knees-up energy TeeJays is famous for in Tameside`
  },
  'stalybridge': {
    src: '/images/services/weddings/wedding-reception-first-dance-lights-28123410.jpg',
    alt: `Classic emotional first dance under gorgeous lights with family watching at a personal Stalybridge wedding — the moment every couple dreams of, executed perfectly`
  },
  'oldham': {
    src: '/images/services/weddings/wedding-string-lights-crowd-celebration-10360901.jpg',
    alt: `Vibrant crowd dancing under string lights at an Oldham wedding — high-energy, multi-generational celebration and the community feel that makes TeeJays the local favourite`
  },
  'manchester': {
    src: '/images/services/weddings/wedding-bride-dancefloor-smile-12417635.jpg',
    alt: `Smiling bride and euphoric guests on the dancefloor at a stylish city-centre Manchester wedding — dramatic lighting and nonstop joy from TeeJays`
  },
  'altrincham': {
    src: '/images/services/weddings/wedding-guests-dancing-string-lights-29569636.jpg',
    alt: `Elegant yet buzzing string-lit dancefloor at a refined Altrincham wedding — premium local standards met with the warm, floor-filling magic only TeeJays brings`
  },
};
const heroImage = weddingHeroImages[slug] || { 
  src: '/images/services/weddings/wedding-reception-first-dance-lights-28123410.jpg', 
  alt: `Beautiful wedding reception dancefloor with guests celebrating in ${area.name}` 
};

// Derived unique content for this specific area — makes every page feel different
const primaryVenue = intel.venues[0];
const venueList = intel.venues.map((v) => v.name).join(' and ');
const topRequests = intel.crowdProfile.requests.slice(0, 3).join(', ');
const crowdVibe = intel.crowdProfile.vibe;
const typicalCrowd = intel.crowdProfile.typicalAges;
const firstDanceInsight = intel.firstDanceTips || `We always ask for the story behind the first dance song. The best ones are the ones that mean something to the couple and their families.`;
const hasStories = intel.stories.length > 0;
const logisticsSummary = intel.logistics.map((l) => l.detail).join(' ');
const isHighVolume = slug === 'tameside' || slug === 'stockport';

// Elite-only derived data for Tameside & Stockport (highest-volume wedding pages)
const firstDanceExamples = intel.firstDanceExamples || [];
const localTrends = intel.localWeddingTrends || '';
const bookingUrgency = intel.bookingUrgency || '';
const isTameside = slug === 'tameside';
const isStockport = slug === 'stockport';

// Pre-computed venue story for the stories section (safe, uses real lastPlayed data from localIntelligence)
const venueWithStory = intel.venues.find((v) => v.lastPlayed);

const nearbyList = (intel.nearbyAreas || [])
  .map((ns) => areas.find((a) => a.slug === ns))
  .filter((a): a is NonNullable<typeof areas[number]> => Boolean(a));

// === NEW: Pexels wedding image gallery set (rotated for per-area visual uniqueness) — only fast-loading optimized images (<350KB) for instant visual impact and core web vitals ===
const pexelsWeddingImages = [
  { src: '/images/services/weddings/wedding-bride-dancefloor-smile-12417635.jpg', caption: 'Pure joy on the dancefloor — the smiles that tell you the night is perfect' },
  { src: '/images/services/weddings/wedding-guests-dancing-string-lights-29569636.jpg', caption: 'String-lit dancefloors where three generations party together all night' },
  { src: '/images/services/weddings/wedding-string-lights-crowd-celebration-10360901.jpg', caption: 'Vibrant crowds under magical lights — the energy that keeps every wedding unforgettable' },
  { src: '/images/services/weddings/wedding-reception-first-dance-lights-28123410.jpg', caption: 'The emotional first dance under beautiful lights — the moment the whole room falls in love with the night' },
];
const galleryStart = (slug.length + intel.venues.length) % pexelsWeddingImages.length;
const featuredGallery = [...pexelsWeddingImages.slice(galleryStart), ...pexelsWeddingImages.slice(0, galleryStart)].slice(0, 4);

// === NEW: Area-tailored FAQ content for SEO (long-tail keywords) + conversion trust ===
// Pulls directly from rich localIntelligence (venues, logistics, firstDanceTips, crowdProfile)
const areaFAQs = [
  {
    q: `What first dance songs work best for ${area.name} weddings?`,
    a: `${firstDanceInsight} We’ve tested what lands with ${crowdVibe} crowds at venues like ${primaryVenue.name} and ${intel.venues[1]?.name || 'local favourites'}.`
  },
  {
    q: `How do you handle curfews, loading and timing at ${area.name} wedding venues?`,
    a: `${logisticsSummary} We build the entire night backwards from your chosen finish time so the dancefloor is still full when the lights come up.`
  },
  {
    q: `Will you play the specific requests our ${area.name} guests want?`,
    a: `Yes — ${area.name} crowds love ${topRequests} and we read the room perfectly. Nothing feels like a generic USB playlist. Every set is built for the people in the room that night.`
  },
];
if (intel.logistics.length > 0) {
  areaFAQs.push({
    q: `What’s the biggest thing couples worry about with wedding DJs in ${area.name}?`,
    a: `${intel.logistics[0].detail} We’ve played these rooms dozens of times — you get zero surprises and maximum dancefloor.`
  });
}

// === Enhanced Schema for better SEO (Service + area-specific details) ===
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Wedding DJ Hire',
  provider: {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}/#business`,
    name: business.name,
  },
  areaServed: {
    '@type': 'Place',
    name: area.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: area.name,
      addressRegion: business.addressRegion,
      addressCountry: business.addressCountry,
    },
  },
  name: `Local Wedding DJs in ${area.name} | First Dance Specialists`,
  description: `Professional local wedding DJs in ${area.name}. ${intel.localPride} 35+ years experience. First dance specialists with deep local knowledge of ${venueList}. Tailored music for ${typicalCrowd} crowds who love ${topRequests}. Real stories and proven results from ${area.name} weddings.`,
  url: `${siteUrl}/wedding-djs/${area.slug}/`,
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'GBP',
    description: `Full pro sound, lighting & MC for ${area.name} weddings`
  }
};

// FAQ schema for rich results in Google (huge SEO win for these pages)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: areaFAQs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<Layout
  title={`Local Wedding DJs in ${area.name} | First Dance Specialists | TeeJays Disco`}
  description={`${intel.localPride} Expert local wedding DJs in ${area.name} — 35+ years experience, first dance specialists who know ${venueList} and exactly how ${crowdVibe} crowds move. Full pro sound, lighting & MC. Book early for ${area.name} weddings.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <!-- Preload the LCP hero image for this specific area+service page to improve mobile Core Web Vitals (LCP) -->
  <link slot="head" rel="preload" as="image" href={heroImage.src} fetchpriority="high" />

  <main class="page">
    <Header />

    <!-- Prominent phone-first conversion bar - visible immediately on every wedding-djs/[area] page for highest conversion -->
    <div class="top-phone-cta">
      <div class="top-phone-inner">
        <span class="top-phone-label">Your local {area.name} wedding DJs — call now</span>
        <a class="top-phone-link" href={contact.phoneHref}>
          <Icon name="phone" /> <strong>{contact.phone}</strong>
        </a>
        <a class="top-phone-link whatsapp" href={contact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" /> WhatsApp Tony &amp; John
        </a>
        <span class="top-phone-urgency">{isHighVolume ? 'Peak dates at Hyde, Ashton, Bramall & Town Hall booking 8–14 months ahead — call now' : `Most popular ${area.name} dates book 6-9 months ahead — secure yours`}</span>
      </div>
    </div>

    <PageHero
      title={`Wedding DJs in ${area.name}`}
      subtitle={`${intel.localPride} First dance specialists who know ${venueList}, read ${crowdVibe} crowds perfectly, and make every ${area.name} wedding feel personal and unforgettable.`}
      image={heroImage.src}
      imageAlt={heroImage.alt}
      ctas={[
        { label: `Check ${area.name} wedding availability`, href: '/contact/', icon: 'calendar', variant: 'primary' },
        { label: `Call Tony & John: ${contact.phone}`, href: contact.phoneHref, icon: 'phone', variant: 'ghost' },
        { label: 'WhatsApp us now', href: contact.whatsappHref, icon: 'whatsapp', variant: 'whatsapp' },
      ]}
    />

    <section class="section">
      <Breadcrumbs items={[{ label: 'Wedding DJs', href: '/wedding-djs/' }, { label: area.name }]} />

      <div class="content-panel">
        <div class="content-card">
          <h2>The wedding DJs in {area.name} who actually know your area</h2>
          <p class="lede">{intel.localPride}</p>
          <p>
            If you’re planning your wedding in {area.name}, you’re bringing together {typicalCrowd} — your family, your friends, the people who mean everything. These are {crowdVibe} crowds who love {topRequests} and more.
            The nights couples remember for decades are the ones where the music feels like it was made for that exact room and that exact group of people — not a generic playlist.
            We’ve played dozens of weddings right here in {area.name}. We know the venues, how your guests will move, and exactly how to pace the night so every generation stays on the floor celebrating your day.
          </p>

          <!-- Strengthened trust signals speaking directly to couples -->
          <div class="trust-row">
            <div class="trust-item"><Icon name="star" /> <span>35+ years each — trusted by {area.name} couples</span></div>
            <div class="trust-item"><Icon name="pin" /> <span>Deep {area.name} knowledge — we live it</span></div>
            <div class="trust-item"><Icon name="shield" /> <span>Fully insured &amp; PAT tested</span></div>
            <div class="trust-item"><Icon name="speaker" /> <span>Pro sound + lighting that fills the room</span></div>
            <div class="trust-item"><Icon name="users" /> <span>Hundreds of local {area.name} weddings</span></div>
          </div>

          <ul class="check-list">
            <li><span><Icon name="check" /></span>First dance specialists — we ask for the story behind your song</li>
            <li><span><Icon name="check" /></span>We read {crowdVibe} {area.name} crowds perfectly and keep the energy right all night</li>
            <li><span><Icon name="check" /></span>Full professional sound, lighting and friendly MC when you need it</li>
            <li><span><Icon name="check" /></span>Real hands-on experience at the exact venues you’re considering</li>
          </ul>

          <!-- Elite primary phone + form CTA right at the top for immediate conversion - multiple strong actions -->
          <div class="cta-group primary-conversion">
            <a class="button primary button-lg" href="/contact/">
              <Icon name="calendar" />
              Check {area.name} wedding availability now
            </a>
            <a class="button ghost button-lg" href={contact.phoneHref}>
              <Icon name="phone" />
              <strong>Call Tony &amp; John: {contact.phone}</strong>
            </a>
            <a class="button ghost button-lg" href={contact.whatsappHref} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" />
              WhatsApp us now
            </a>
          </div>
          <p class="cta-note urgency-note"><strong>Most popular {area.name} wedding dates book 6-9 months ahead.</strong> The best slots at {primaryVenue.name} and other top venues are already filling for 2026/2027. Secure the local DJs who know your area — enquire today.</p>
        </div>

        <!-- Especially strong area-specific persuasion for Tameside (home turf) and Stockport (highest competition/volume) -->
        {isHighVolume && (
          <div class="content-card elite-persuasion">
            <h2>Why {area.name} couples book us instead of the hundreds of other DJs</h2>
            {isTameside ? (
              <p><strong>You’re booking your local Tameside DJs.</strong> We’re based right here — we know every town hall from Ashton to Mossley, every traffic bottleneck on the M67, every power point and load-in at Hyde Town Hall, Stalybridge Civic and Dukinfield. When your family from Denton, Droylsden and beyond gathers to celebrate, the music has to feel like home. That’s exactly what we bring: community pride, sing-along anthems, and the warm, loud, generous Tameside spirit that fills dancefloors until midnight. No one else understands your borough the way we do.</p>
            ) : (
              <p><strong>Stockport expects the best — and we deliver.</strong> With 300+ DJs advertising in the borough, most couples quickly realise the difference between a generic “we travel anywhere” DJ and true local professionals who have repeatedly delivered at Bramall Hall, Stockport Town Hall, Bredbury Hall and Alma Lodge. We read the smart, proud, fun-loving Stockport crowd perfectly. We arrive looking sharp, sounding exceptional, and we leave the room talking about the night for years. Your wedding in Stockport deserves that level of care and expertise.</p>
            )}
            <div class="cta-group" style="margin-top: var(--space-3);">
              <a class="button primary" href={contact.phoneHref}><Icon name="phone" /> Call {contact.phone} — Local experts ready now</a>
              <a class="button ghost" href="/contact/">Tell us about your {area.name} day</a>
            </div>
          </div>
        )}

        <div class="content-card">
          <h2>Venues we know for weddings in {area.name}</h2>
          <p>These are the rooms we’ve actually played, loaded into, powered up, and learned the quirks of. Real details matter on a wedding day — and we’ve done the homework so you don’t have surprises.</p>

          {intel.venues.length > 0 ? (
            <div class="venue-intel-grid">
              {intel.venues.map((venue) => (
                <div class="venue-intel-card">
                  <div class="venue-header">
                    <strong>{venue.name}</strong>
                    <span class="venue-type">{venue.type.replace('-', ' ')}</span>
                  </div>
                  <p class="venue-notes">{venue.notes}</p>

                  <div class="venue-specs">
                    {venue.capacity && <div><span>Capacity</span> {venue.capacity}</div>}
                    <div><span>Parking</span> {venue.parking}</div>
                    <div><span>Power</span> {venue.power}</div>
                    <div><span>Loading</span> {venue.loading}</div>
                  </div>

                  {venue.musicFit && <p class="venue-music"><strong>Music fit:</strong> {venue.musicFit}</p>}
                  {venue.lastPlayed && <p class="venue-story"><em>{venue.lastPlayed}</em></p>}
                </div>
              ))}
            </div>
          ) : (
            <p>We regularly play weddings across {area.name} in hotels, function rooms, barns and private homes. Ask us about your venue.</p>
          )}

          <a class="inline-cta" href="/contact/">Not seeing your venue? Tell us about it →</a>

          <!-- Stronger post-venues conversion CTA with phone + WhatsApp + form for couples - multiple paths -->
          <div class="venue-cta">
            <p><strong>Love your {area.name} venue but worried the music won’t do justice to your day?</strong> We’ve loaded in, powered up and delivered unforgettable nights at these exact rooms — {venueList}. We know the acoustics, the best spots for the decks, and exactly how to turn your first dance into the moment your guests never forget.</p>
            <div class="cta-group">
              <a class="button primary" href="/contact/">
                <Icon name="calendar" /> Enquire about your wedding at {primaryVenue.name}
              </a>
              <a class="button ghost" href={contact.phoneHref}>
                <Icon name="phone" /> <strong>Call {contact.phone}</strong>
              </a>
              <a class="button ghost" href={contact.whatsappHref} target="_blank" rel="noopener noreferrer">
                <Icon name="whatsapp" /> WhatsApp us
              </a>
            </div>
            <p class="cta-note" style="margin-top: var(--space-3);"><strong>Most popular {area.name} wedding dates book 6-9 months ahead.</strong> Your perfect date at {primaryVenue.name} is already being reserved by other couples — reach us today to lock it in.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <SectionTitle title={`Music that works for weddings in ${area.name}`} subtitle="Not a generic playlist — the right songs for the people who actually live here." />

      <div class="music-prefs">
        {intel.musicNotes.map((note) => (
          <div class="music-note">
            <div class="music-decade">{note.decade}</div>
            <div class="music-genres">{note.genres.join(' · ')}</div>
            <p>{note.whyItWorks}</p>
          </div>
        ))}
      </div>
      <p class="music-tail">We build every set around {topRequests} and the energy of the actual room — never the same set twice. Your {area.name} guests will feel the music was chosen just for your wedding day.</p>

      <!-- Music section conversion CTA — direct to couples (multiple strong options) -->
      <div class="local-cta-bar" style="margin-top: var(--space-5);">
        <strong>Planning your {area.name} wedding soundtrack? Most popular dates book 6-9 months ahead.</strong>
        <div class="cta-group" style="margin-top: 0;">
          <a class="button primary button-sm" href="/contact/">Tell us your first dance song &amp; favourite tracks →</a>
          <a class="button ghost button-sm" href={contact.phoneHref}><Icon name="phone" /> Call {contact.phone}</a>
          <a class="button ghost button-sm" href={contact.whatsappHref} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /> WhatsApp now</a>
        </div>
      </div>
    </section>

    <section class="section">
      <SectionTitle title={`What makes a great wedding night in ${area.name}`} subtitle="Local realities that turn a good night into an unforgettable one." />

      <div class="content-panel three-col">
        <div class="content-card">
          <h2>Local crowd knowledge</h2>
          <p>{crowdVibe} crowds in {area.name} — typically {typicalCrowd} — tend to respond best to {intel.musicNotes[0]?.genres.join(', ')} early on. We know exactly when to push the energy and when to let it breathe so the whole room stays involved.</p>
        </div>
        <div class="content-card">
          <h2>Venue realities</h2>
          <p>We’ve loaded into, powered up, and played in the actual rooms you’re considering — {venueList}. That means fewer surprises on the day, perfect sound levels, and smooth transitions between speeches and dancing.</p>
        </div>
        <div class="content-card">
          <h2>Timing that actually works</h2>
          <p>{logisticsSummary} We plan the night backwards from the end so the dancefloor is still full when the lights come on — no awkward early wind-downs.</p>
        </div>
      </div>

      <div class="local-cta-bar">
        <strong>Planning a {area.name} wedding? Most popular dates book 6-9 months ahead.</strong>
        <div class="cta-group" style="margin-top:0;">
          <a class="button primary button-sm" href="/contact/">Speak to us about the right music for your crowd →</a>
          <a class="button ghost button-sm" href={contact.phoneHref}><Icon name="phone" /> Call {contact.phone}</a>
        </div>
      </div>
    </section>

    <!-- NEW: Dedicated Pexels wedding image gallery for visual trust, SEO image content & conversion -->
    <section class="section wedding-visuals">
      <SectionTitle 
        title={`Real ${area.name} wedding moments we create`} 
        subtitle="The energy, the emotion, the packed dancefloors — this is what your guests will remember." 
      />
      <div class="wedding-gallery">
        {featuredGallery.map((img) => (
          <div class="gallery-item">
            <img 
              src={img.src} 
              alt={`${area.name} wedding: ${img.caption} — real moments created by TeeJays Disco`} 
              width="900" 
              height="600" 
              loading="lazy" 
              decoding="async" 
              fetchpriority="low"
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
            />
            <p class="gallery-caption">{img.caption}</p>
          </div>
        ))}
      </div>
      <p class="gallery-note">
        These moments happen at real weddings across Greater Manchester. We bring the same care, local knowledge and floor-filling music to your {area.name} day.
      </p>
      <div class="cta-group" style="justify-content: center; margin-top: var(--space-4);">
        <a class="button primary button-lg" href="/contact/">Bring this energy to your {area.name} wedding →</a>
        <a class="button ghost button-lg" href={contact.phoneHref}>Or call {contact.phone} today</a>
      </div>
    </section>

    <section class="section">
      <SectionTitle title={`How we run weddings in ${area.name}`} subtitle="Local knowledge that makes the day smoother — and the first dance perfect." />

      <div class="content-panel">
        <div class="content-card highlight">
          <h2>Your first dance — the moment your {area.name} wedding becomes unforgettable</h2>
          <p class="lede-small">{firstDanceInsight}</p>
          <p>Close your eyes and picture it: the lights dim, the room falls hushed, your family and friends — the people who’ve known you since you were little — are watching with tears in their eyes. You take your partner’s hand. Your chosen song begins. This single moment is what every {area.name} couple dreams of on their wedding day.</p>
          {isTameside ? (
            <p>In Tameside it’s even more powerful — three generations of proud Ashton, Hyde, Stalybridge, Denton, Droylsden and Mossley families packed into Hyde Town Hall, Ashton Town Hall or a beautiful barn like Hyde Bank Farm. Your nan and grandad will know every word of your first dance because it’s the same song their parents danced to. That raw, warm, community love fills the hall to the rafters and turns one family’s celebration into a whole borough knees-up. We protect and amplify that exact Tameside spirit.</p>
          ) : isStockport ? (
            <p>In Stockport it carries extra weight and sophistication — the marble staircase at the Town Hall with family who flew in, or the historic beams at Bramall Hall where the entire room holds its breath in perfect silence. Discerning Stockport couples choose songs with real personal story. We treat that moment like the centrepiece it is: perfect lighting timed to every lyric, perfect sound, perfect timing, then the seamless, exciting explosion into the party that even the sharpest guests still talk about years later.</p>
          ) : (
            <p>In {area.name} it’s even more special — multigenerational families, proud local communities, the kind of love that fills a historic hall, manor or barn to the rafters.</p>
          )}
          <p>We don’t just press play. Weeks before your date, we call you personally. We ask about the story behind the song — why that one? The nerves, the meaning, the little detail only you two know. On the day we arrive early, set the lights exactly right for your specific room and your guests, balance the sound so your voices carry but the emotion stays intimate and powerful. When the final note fades, we transition seamlessly into the biggest celebration of your lives — the floor fills with every generation dancing, laughing, singing along to the music that feels made exactly for your {area.name} wedding that night. This is the difference couples still message us about years later: “you made our day perfect”.</p>
        </div>

        <!-- Emotional first-dance conversion CTA with phone + WhatsApp (multiple placement) - strongest conversion push -->
        <div class="content-card" style="border-color: var(--pink); background: linear-gradient(145deg, var(--paper), var(--paper-2)); text-align: center;">
          <p style="font-size: 1.1rem; font-weight: 700; margin-bottom: var(--space-3);">Your first dance deserves to be perfect. Let’s make that {area.name} moment unforgettable together.</p>
          <div class="cta-group" style="justify-content: center;">
            <a class="button primary button-lg" href="/contact/">
