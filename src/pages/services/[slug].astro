---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Layout from '../../layouts/Layout.astro';
import { areas, business, services } from '../../data/site';

export const prerender = true;

export function getStaticPaths() {
	return services.map((service) => ({ params: { slug: service.slug } }));
}

const { slug } = Astro.params;
const service = services.find((item) => item.slug === slug)!;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? business.url;

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	serviceType: `${service.title} DJ`,
	provider: {
		'@type': 'LocalBusiness',
		'@id': `${siteUrl}/#business`,
		name: business.name,
	},
	areaServed: business.serviceArea.map((name) => ({ '@type': 'AdministrativeArea', name })),
	name: `${service.title} DJ Services`,
	description: service.intro,
	url: `${siteUrl}/services/${service.slug}/`,
	image: service.image.startsWith('http') ? service.image : `${siteUrl}${service.image}`,
};
---

<Layout
	title={`${service.title} DJ Services | TeeJays Disco`}
	description={`${service.intro} TeeJays Disco covers Tameside, Manchester and the North West.`}
	image={service.image}
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
	<main class="page">
		<Header />
		<PageHero title={`${service.title} DJ Services`} subtitle={service.intro} image={service.image} />

		<section class="section">
			<Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: service.title }]} />

			<div class="detail-layout">
				<img class="detail-image" src={service.image} alt={`${service.title} DJ event with TeeJays Disco`} width="1200" height="800" loading="lazy" decoding="async" />
				<div class="detail-copy">
					<h2>{service.title}</h2>
					<p>{service.intro}</p>
					<ul class="check-list">
						{service.highlights.map((highlight) => (
							<li><span><Icon name="check" /></span>{highlight}</li>
						))}
					</ul>
					<p>
						Tell us your date, venue and the kind of night you want. We will confirm what is practical,
						what setup is needed and whether the date is available.
					</p>
					<a class="button primary" href="/contact/">
						<Icon name="calendar" />
						Check Availability
					</a>
				</div>
			</div>
		</section>

		<section class="section">
			<SectionTitle title={`${service.title} DJ hire across Greater Manchester`} subtitle={`Local ${service.title.toLowerCase()} DJs in the area you need.`} />
			<div class="area-link-grid">
				{areas.filter((area) => area.featured).map((area) => (
					<a class="area-link-card" href={`/areas/${area.slug}/`}>
						<Icon name="pin" />
						<span>{service.title} DJ in {area.name}</span>
					</a>
				))}
				<a class="area-link-card" href="/areas/">
					<Icon name="plus" />
					<span>View all areas</span>
				</a>
			</div>
		</section>

		<ContactBlock faq={false} />
		<Footer />
	</main>
</Layout>
