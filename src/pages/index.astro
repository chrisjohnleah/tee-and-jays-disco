---
import AboutArea from '../components/AboutArea.astro';
import Footer from '../components/Footer.astro';
import GalleryStrip from '../components/GalleryStrip.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HomeCTA from '../components/HomeCTA.astro';
import ReviewsGrid from '../components/ReviewsGrid.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatStrip from '../components/StatStrip.astro';
import Layout from '../layouts/Layout.astro';
import { services } from '../data/site';

export const prerender = true;
---

<Layout
	title="TeeJays Disco | Mobile DJs for Tameside & Manchester Events"
	description="Tony and John from TeeJays Disco are experienced mobile party DJs for weddings, birthdays, corporate events and private celebrations across Tameside, Manchester and the North West."
>
	<main class="page">
		<Header />
		<Hero />
		<StatStrip />

		<section class="section services" id="services">
			<SectionTitle title="Our Services" subtitle="Music for every occasion. Memories for a lifetime." />
			<div class="service-grid">
				{services.map((service) => <ServiceCard service={service} />)}
			</div>
		</section>

		<AboutArea />
		<ReviewsGrid limit={3} />
		<GalleryStrip />
		<HomeCTA />
		<Footer />
	</main>
</Layout>
