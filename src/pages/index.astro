---
import AboutArea from '../components/AboutArea.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HomeCTA from '../components/HomeCTA.astro';
import Marquee from '../components/Marquee.astro';
import ReviewsGrid from '../components/ReviewsGrid.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatStrip from '../components/StatStrip.astro';
import Layout from '../layouts/Layout.astro';
import { services } from '../data/site';

export const prerender = true;

const marqueeItems = [
	'Weddings',
	'18ths — 80ths',
	'Corporate dos',
	'Pubs & clubs',
	'Anniversaries',
	'School discos',
	'Community events',
	'2026 dates',
];
---

<Layout
	title="TeeJays Disco | Mobile DJs for Tameside & Manchester Events"
	description="Tony and John from TeeJays Disco are experienced mobile party DJs for weddings, birthdays, corporate events and private celebrations across Tameside, Manchester and the North West."
>
	<main class="page">
		<Header />
		<Hero />
		<Marquee items={marqueeItems} variant="lime" />
		<StatStrip />

		<section class="section services" id="services">
			<SectionTitle title="What we play" subtitle="One booking, every kind of night." />
			<div class="service-grid">
				{services.map((service) => <ServiceCard service={service} />)}
			</div>
		</section>

		<AboutArea />
		<ReviewsGrid limit={3} />
		<HomeCTA />
		<Footer />
	</main>
</Layout>
