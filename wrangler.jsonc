{
	// Tee and Jays Disco — Astro dev / local build config
	// Used by `astro dev` and `astro build` via @astrojs/cloudflare.
	// Production deploy uses wrangler.worker.jsonc.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tee-and-jays-disco",
	"account_id": "29ff2841d256c2cf5a789a56f8927a04",

	// Pin to a recent, well-baked compat date. Bump after testing.
	"compatibility_date": "2026-04-01",
	"compatibility_flags": ["nodejs_compat"],

	// Smart placement: runtime picks a colo close to the data the worker
	// fetches (Images, KV, etc.) instead of always running at the eyeball.
	// Free for static sites — measurable wins when any subrequest exists.
	"placement": { "mode": "smart" },

	// Workers Observability + Logs (replaces legacy Tail).
	// Visible in dash → Workers → Logs and queryable via the API.
	// head_sampling_rate of 1.0 = capture every invocation. Drop to 0.5
	// or 0.1 if log volume becomes expensive.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},

	"images": {
		"binding": "IMAGES"
	},

	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "e690209524684d0cbf14f707588cc78c"
		}
	]
}
