{
  // Tee and Jays Disco — Astro build config
  // Account: john easylamb
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tee-and-jays-disco",
  "compatibility_date": "2025-05-07",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION"
    }
  ]
}
