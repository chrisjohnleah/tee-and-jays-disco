{
	// Tee and Jays Disco — Cloudflare Worker production deploy config.
	// Build first: `npm run build` → emits dist/server + dist/client.
	// Deploy:      `npx wrangler deploy --config wrangler.worker.jsonc`.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tee-and-jays-disco",
	"account_id": "29ff2841d256c2cf5a789a56f8927a04",
	"main": "./dist/server/entry.mjs",
	"base_dir": "./dist/server",

	// Pin to a recent, well-baked compat date. Keep in sync with
	// wrangler.jsonc so dev and prod execute against the same runtime.
	"compatibility_date": "2026-04-01",
	"compatibility_flags": ["nodejs_compat"],

	// Smart placement — runtime decides whether to colocate near
	// subrequest targets (Images, KV, fetch origins) instead of running
	// at the eyeball. No cost change for this workload.
	"placement": { "mode": "smart" },

	// Workers Observability + Logs. Captures every invocation (including
	// console.* output) and surfaces them in dash → Workers → Logs.
	// head_sampling_rate = fraction of invocations recorded.
	//   1.0 = 100% (fine for this traffic volume)
	//   0.1 = 10% (drop to this if log billing becomes meaningful)
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},

	// Static assets served directly from edge (HTML, CSS, JS, images).
	// The ASSETS binding lets the SSR worker fall back to the static
	// build when no SSR route matches.
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},

	"rules": [
		{
			"type": "ESModule",
			"globs": ["**/*.js", "**/*.mjs"]
		}
	],

	"find_additional_modules": true,
	"no_bundle": true,

	"images": {
		"binding": "IMAGES"
	},

	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "e690209524684d0cbf14f707588cc78c"
		}
	]
}
